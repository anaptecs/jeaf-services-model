                  <ownedComment xmi:id="95201289-13b2-40b6-a3c0-31e26fed8d9e" body="A static version of the above.&#xA;" annotatedElement="08f12c62-4414-4f0b-98d4-887fd4689e90"/>
                  <generalization xmi:id="f2384a14-2a6e-4e0b-aeb9-60f83b34e781" isSubstitutable="true" general="d6b1b354-07ef-4998-b899-81035a3a05f0"/>
