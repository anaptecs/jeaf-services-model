          <packagedElement xmi:type="uml:Class" xmi:id="6cdfb935-f1e5-4497-9ef8-2a58807cabcb" name="DelegatingDefaultFocusManager" visibility="package" isLeaf="true">
            <ownedComment xmi:id="8e062665-35bf-42e8-8a83-9ee5c6c6b475" body="Provides a javax.swing.DefaultFocusManager view onto an arbitrary&#xA;java.awt.KeyboardFocusManager. We subclass DefaultFocusManager instead of&#xA;FocusManager because it seems more backward-compatible. It is likely that&#xA;some pre-1.4 code assumes that the object returned by&#xA;FocusManager.getCurrentManager is an instance of DefaultFocusManager unless&#xA;set explicitly.&#xA;" annotatedElement="6cdfb935-f1e5-4497-9ef8-2a58807cabcb"/>
            <generalization xmi:id="504ebe2b-170e-4c1a-b245-8fa14662d1ae" isSubstitutable="true" general="2ec7d5ca-5c5e-416c-88b1-753c86f01212"/>
          </packagedElement>
