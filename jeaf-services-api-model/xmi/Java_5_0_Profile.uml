              <packagedElement xmi:type="uml:Class" xmi:id="e83ff9db-c752-4fe6-87da-be61c63e8f3a" name="AtomicIntegerFieldUpdater&lt;T>">
                <templateBinding xmi:id="daa1fa5b-b82e-4b46-a1c4-e9c9dd4e30af" signature="c6b103fc-3e72-46b3-bf4c-cd731b8a4a45">
                  <parameterSubstitution xmi:id="622243a1-0e72-4fb9-a23e-911e4886832a" formal="1bba68d0-214c-4dc4-afdc-7e6affa1527c" actual="71fad112-566e-4ac5-806a-bb18a5c83f53"/>
