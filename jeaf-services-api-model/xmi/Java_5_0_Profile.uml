            <nestedClassifier xmi:type="uml:Class" xmi:id="18adf038-9dd8-4a19-ba70-3ac44eb95a48" name="AccessibleJPopupMenu" visibility="protected" clientDependency="f0a70b41-e08a-46fc-898d-4ecfa6d52adc">
              <ownedComment xmi:id="299bcf17-7b53-4c39-bbe8-f9ba7f23acdb" body="This class implements accessibility support for the&#xA;&lt;code>JPopupMenu&lt;/code> class.  It provides an implementation of the&#xA;Java Accessibility API appropriate to popup menu user-interface&#xA;elements.&#xA;" annotatedElement="18adf038-9dd8-4a19-ba70-3ac44eb95a48"/>
