              <interfaceRealization xmi:id="8ff399c8-d5c8-4025-82ce-5ccf2ca33414" name="" supplier="f68aec46-50b5-48d7-b5b4-79aa18484c4c" client="b7787830-a7a1-488d-ba5c-07e60c01258e" contract="f68aec46-50b5-48d7-b5b4-79aa18484c4c"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="963037a6-0f8a-4e44-a2dd-ba30a0634cb0" name="BeanContextServicesListener" isAbstract="true">
              <ownedComment xmi:id="23414c19-e2d3-4dee-ab9c-68370d3155b9" body="The listener interface for receiving&#xA;&lt;code>BeanContextServiceAvailableEvent&lt;/code> objects.&#xA;A class that is interested in processing a&#xA;&lt;code>BeanContextServiceAvailableEvent&lt;/code> implements this interface.&#xA;" annotatedElement="963037a6-0f8a-4e44-a2dd-ba30a0634cb0"/>
              <generalization xmi:id="abdc3ea2-2b05-4f75-933e-03f700c44853" isSubstitutable="true" general="be439f2a-5437-40e8-9412-5f08948852ba"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="e0fc700a-7166-4814-871f-10121480e054" name="BeanContextServicesSupport" clientDependency="bc9c3d02-ed3a-44bc-bb95-f3d0c8bc664b">
              <ownedComment xmi:id="b303c9fc-7edc-42f0-a93f-dda1a0da8ecc" body="&lt;p>&#xA;This helper class provides a utility implementation of the&#xA;java.beans.beancontext.BeanContextServices interface.&#xA;&lt;/p>&#xA;&lt;p>&#xA;Since this class directly implements the BeanContextServices interface,&#xA;the class can, and is intended to be used either by subclassing this&#xA;implementation, or via delegation of an instance of this class&#xA;from another through the BeanContextProxy interface.&#xA;&lt;/p>&#xA;&#xA;@author Laurence P. G. Cable&#xA;@version 1.23, 04/15/04&#xA;@since 1.2&#xA;" annotatedElement="e0fc700a-7166-4814-871f-10121480e054"/>
              <generalization xmi:id="1848cbdb-8ed8-4cf5-a179-b865fafe9abe" isSubstitutable="true" general="2b34b99f-6deb-4979-b633-4cc8e4ec1cd2"/>
