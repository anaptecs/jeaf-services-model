                <ownedComment xmi:id="c148ada9-423b-4d1d-b6cb-3e8d35229135" body="A Basic L&amp;F implementation of ToolBarSeparatorUI.  This implementation&#xA;is a &quot;combined&quot; view/controller.&#xA;&lt;p>&#xA;&#xA;@version 1.13 12/19/03&#xA;@author Jeff Shapiro&#xA;" annotatedElement="51b4f99f-107c-4a45-86aa-930f1c0f5fed"/>
                <generalization xmi:id="606c78d0-1b20-41cd-8cb7-a5923c3034d4" isSubstitutable="true" general="6356b684-7544-402b-9a73-fad8a937376e"/>
