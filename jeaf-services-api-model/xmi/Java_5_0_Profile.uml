              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="78e4fea7-d9dc-4290-9659-6e5e3fd31b09" isSubstitutable="true" general="884116a5-095b-44ee-8776-27b791384a79"/>
          </packagedElement>
