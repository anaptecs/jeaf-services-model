              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="dbe5de31-8160-4576-9a6f-8cc969ad6322" name="ChangeUpdateRunnable" visibility="package" clientDependency="2979033d-f6e8-4555-8a8f-11522d99555d">
                <ownedComment xmi:id="f7304c42-6d4e-4460-bdf3-61e56d4686ee" body="When run this creates a change event for the complete document&#xA;and fires it.&#xA;" annotatedElement="dbe5de31-8160-4576-9a6f-8cc969ad6322"/>
