                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="c4898dcc-3c90-4f05-9107-07e1bd90a6a2" parameteredElement="b896fa01-ddc0-4c1a-b97d-35d305ff0340">
