          <packagedElement xmi:type="uml:Class" xmi:id="fe427faa-d18a-4791-94eb-e43083854086" name="AncestorNotifier" visibility="package" clientDependency="24b08bea-e7fa-483a-9474-4ad45328a443 bfb60921-b014-4f47-b2ef-4fbf63b4c312 0d889482-2d66-43df-8e0e-a8561602e551">
            <ownedComment xmi:id="1011d173-f931-48d1-b15e-38e449d1ae4c" body="@version 1.19 12/19/03&#xA;@author Dave Moore&#xA;" annotatedElement="fe427faa-d18a-4791-94eb-e43083854086"/>
