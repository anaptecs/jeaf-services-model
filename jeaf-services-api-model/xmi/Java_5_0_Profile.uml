                  <nestedClassifier xmi:type="uml:Class" xmi:id="de0cb502-df90-4aa0-be3b-9f326e31f47b" name="TextTransferable" visibility="package">
                    <ownedComment xmi:id="d0fad50d-3bbe-4c0e-a457-946fe815b3ac" body="A possible implementation of the Transferable interface&#xA;for text components.  For a JEditorPane with a rich set&#xA;of EditorKit implementations, conversions could be made&#xA;giving a wider set of formats.  This is implemented to&#xA;offer up only the active content type and text/plain&#xA;(if that is not the active format) since that can be&#xA;extracted from other formats.&#xA;" annotatedElement="de0cb502-df90-4aa0-be3b-9f326e31f47b"/>
