          <packagedElement xmi:type="uml:Interface" xmi:id="7ea743b4-f9af-424b-8254-37f7b184632b" name="ComboBoxEditor" isAbstract="true">
            <ownedComment xmi:id="551934d4-7198-482f-a164-588cdb915f62" body="The editor component used for JComboBox components.&#xA;&#xA;@version 1.13 12/19/03&#xA;@author Arnaud Weber&#xA;" annotatedElement="7ea743b4-f9af-424b-8254-37f7b184632b"/>
