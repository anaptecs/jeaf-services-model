            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="8cf9b823-377a-4024-a3f0-9834dbb39607" name="BlockingQueue&lt;E>">
              <templateBinding xmi:id="de91e550-794b-4044-856f-e7ace1abe2f4" signature="535a8bcf-c420-473e-a9eb-0c14e816d3ac">
                <parameterSubstitution xmi:id="9b1e097b-4ee7-43f9-bbb0-179a0da3432b" formal="e8438b11-9ad9-4362-be89-2c02fc7d051c" actual="0dbf7216-1cfb-4f4f-b614-b53041f54a85"/>
