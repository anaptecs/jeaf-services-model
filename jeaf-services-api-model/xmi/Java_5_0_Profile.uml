          <packagedElement xmi:type="uml:Class" xmi:id="b5ae222e-9ea6-466a-9536-a474480fc98c" name="TimerTask" clientDependency="4ae9913e-5cf3-4b16-8949-c76978b59eb2" isAbstract="true">
            <ownedComment xmi:id="6b352c9c-6a3e-4f8d-9fdb-a0adb18d4222" body="A task that can be scheduled for one-time or repeated execution by a Timer.&#xA;&#xA;@author  Josh Bloch&#xA;@version 1.10, 02/19/04&#xA;@see&#x9;    Timer&#xA;@since   1.3&#xA;" annotatedElement="b5ae222e-9ea6-466a-9536-a474480fc98c"/>
