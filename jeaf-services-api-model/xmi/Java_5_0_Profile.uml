              <packagedElement xmi:type="uml:Class" xmi:id="1fb13da9-5cfd-40e7-a1f7-98efdf6b3bff" name="MetalComboBoxIcon" clientDependency="d00eedc1-e1ef-4b02-911a-c1bf8c00abf2 f244a0f7-74a7-4beb-8fba-849ae3a278c1">
                <ownedComment xmi:id="69bafda1-acc2-4316-9cd2-e8b49a29f008" body="This utility class draws the horizontal bars which indicate a MetalComboBox&#xA;&#xA;@see MetalComboBoxUI&#xA;@version 1.13 12/19/03&#xA;@author Tom Santos&#xA;" annotatedElement="1fb13da9-5cfd-40e7-a1f7-98efdf6b3bff"/>
                <interfaceRealization xmi:id="f244a0f7-74a7-4beb-8fba-849ae3a278c1" name="" supplier="dd41f3fc-1d64-4973-9f63-c0d7b0c45e96" client="1fb13da9-5cfd-40e7-a1f7-98efdf6b3bff" contract="dd41f3fc-1d64-4973-9f63-c0d7b0c45e96"/>
