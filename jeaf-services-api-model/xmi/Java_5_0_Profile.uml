          <packagedElement xmi:type="uml:Class" xmi:id="ea574cec-f6a2-45cf-a871-4de0d73f56a9" name="ByteBufferAsIntBufferB" visibility="package">
            <generalization xmi:id="f8e8216f-862b-41ee-bda4-bdec0e0cdc12" isSubstitutable="true" general="195697d2-8187-4a6d-94a4-d0d91e439635"/>
