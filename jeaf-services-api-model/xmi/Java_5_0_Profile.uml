                <nestedClassifier xmi:type="uml:Class" xmi:id="6a8dd031-ab1c-442e-8f0c-36a012558822" name="BasicPopupMenuListener" visibility="private" clientDependency="90b76369-5330-43b8-884d-e1cb07b218f9">
                  <ownedComment xmi:id="5e438ac9-6c6d-4fd3-a81d-2e29954ec9ac" body="This Listener fires the Action that provides the correct auditory&#xA;feedback.&#xA;&#xA;@since 1.4&#xA;" annotatedElement="6a8dd031-ab1c-442e-8f0c-36a012558822"/>
                  <interfaceRealization xmi:id="90b76369-5330-43b8-884d-e1cb07b218f9" name="" supplier="d68c4470-c002-4d4b-84f0-123637fc742e" client="6a8dd031-ab1c-442e-8f0c-36a012558822" contract="d68c4470-c002-4d4b-84f0-123637fc742e"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="16e7927d-39e3-45bc-85b4-aa0bc1b98406" name="MenuKeyboardHelper" visibility="private" clientDependency="dfb115ae-5717-4787-bdeb-a205305fe93d a8d084aa-06a8-43d8-bf52-4e716a5987e4">
                  <ownedComment xmi:id="ef090a40-eba8-4347-806c-d863d2913bba" body="This helper is added to MenuSelectionManager as a ChangeListener to&#xA;listen to menu selection changes. When a menu is activated, it passes&#xA;focus to its parent JRootPane, and installs an ActionMap/InputMap pair&#xA;on that JRootPane. Those maps are necessary in order for menu&#xA;navigation to work. When menu is being deactivated, it restores focus&#xA;to the component that has had it before menu activation, and uninstalls&#xA;the maps.&#xA;This helper is also installed as a KeyListener on root pane when menu&#xA;is active. It forwards key events to MenuSelectionManager for mnemonic&#xA;keys handling.&#xA;" annotatedElement="16e7927d-39e3-45bc-85b4-aa0bc1b98406"/>
                  <interfaceRealization xmi:id="dfb115ae-5717-4787-bdeb-a205305fe93d" name="" supplier="7fa702a1-b36f-46ce-84db-f895a45577ee" client="16e7927d-39e3-45bc-85b4-aa0bc1b98406" contract="7fa702a1-b36f-46ce-84db-f895a45577ee"/>
