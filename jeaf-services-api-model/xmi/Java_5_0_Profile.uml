            <packagedElement xmi:type="uml:Class" xmi:id="d0591dc8-bd5c-4c69-9ab5-068df4145568" name="FinalReference" visibility="package">
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="e8dd6f5c-e7fe-4e23-8ad4-5476a76b68b1" name="" parameter="82822716-3a8f-4393-a0a6-5de5578fb3ef">
