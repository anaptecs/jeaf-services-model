              <nestedClassifier xmi:type="uml:Class" xmi:id="03248875-3133-437a-8d8e-95ee6910cbd5" name="AccessibleAWTListChild" visibility="protected" clientDependency="2f94ea73-6357-4a97-aba2-2914a3f99189">
