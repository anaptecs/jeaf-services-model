            <packagedElement xmi:type="uml:Interface" xmi:id="772ed7be-d0df-4672-b199-43be9ee6117b" name="NodeChangeListener" isAbstract="true">
              <ownedComment xmi:id="e21403ed-69b3-4e3c-933b-75edeab36b71" body="A listener for receiving preference node change events.&#xA;&#xA;@author  Josh Bloch&#xA;@version 1.4, 12/19/03&#xA;@see     Preferences&#xA;@see     NodeChangeEvent&#xA;@see     PreferenceChangeListener&#xA;@since   1.4&#xA;" annotatedElement="772ed7be-d0df-4672-b199-43be9ee6117b"/>
              <generalization xmi:id="837f58b5-fc90-4c44-a10b-58b7c0e8f0b5" isSubstitutable="true" general="a4245259-567d-4396-ae9c-b70224f55c0b"/>
