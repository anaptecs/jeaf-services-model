              </nestedClassifier>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="ea633915-dfa8-413c-a62e-7d74dddf3c22" name="MutableTreeNode" isAbstract="true">
              <ownedComment xmi:id="bc3e89ab-fa7b-49b8-b338-c19ff46d090c" body="Defines the requirements for a tree node object that can change --&#xA;by adding or removing child nodes, or by changing the contents&#xA;of a user object stored in the node.&#xA;&#xA;@see DefaultMutableTreeNode&#xA;@see javax.swing.JTree&#xA;&#xA;@version 1.11 12/19/03&#xA;@author Rob Davis&#xA;@author Scott Violet&#xA;" annotatedElement="ea633915-dfa8-413c-a62e-7d74dddf3c22"/>
