              <packagedElement xmi:type="uml:Class" xmi:id="c529129f-3e97-420b-9d41-a5c8e2fc175f" name="MetalRootPaneUI">
                <ownedComment xmi:id="75e65ff2-7873-492a-9acf-924ee3c7157f" body="Provides the metal look and feel implementation of &lt;code>RootPaneUI&lt;/code>.&#xA;&lt;p>&#xA;&lt;code>MetalRootPaneUI&lt;/code> provides support for the&#xA;&lt;code>windowDecorationStyle&lt;/code> property of &lt;code>JRootPane&lt;/code>.&#xA;&lt;code>MetalRootPaneUI&lt;/code> does this by way of installing a custom&#xA;&lt;code>LayoutManager&lt;/code>, a private &lt;code>Component&lt;/code> to render&#xA;the appropriate widgets, and a private &lt;code>Border&lt;/code>. The&#xA;&lt;code>LayoutManager&lt;/code> is always installed, regardless of the value of&#xA;the &lt;code>windowDecorationStyle&lt;/code> property, but the&#xA;&lt;code>Border&lt;/code> and &lt;code>Component&lt;/code> are only installed/added if&#xA;the &lt;code>windowDecorationStyle&lt;/code> is other than&#xA;&lt;code>JRootPane.NONE&lt;/code>.&#xA;&lt;p>&#xA;&lt;strong>Warning:&lt;/strong>&#xA;Serialized objects of this class will not be compatible with&#xA;future Swing releases. The current serialization support is&#xA;appropriate for short term storage or RMI between applications running&#xA;the same version of Swing.  As of 1.4, support for long term storage&#xA;of all JavaBeans&lt;sup>&lt;font size=&quot;-2&quot;>TM&lt;/font>&lt;/sup>&#xA;has been added to the &lt;code>java.beans&lt;/code> package.&#xA;Please see {@link java.beans.XMLEncoder}.&#xA;&#xA;@version 1.20 04/27/04&#xA;@author Terry Kellerman&#xA;@since 1.4&#xA;" annotatedElement="c529129f-3e97-420b-9d41-a5c8e2fc175f"/>
                <generalization xmi:id="04da37a0-355e-4a83-aae8-1373c8d4f953" isSubstitutable="true" general="f57440df-3628-43a0-bfcb-e08d47c510e6"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="368ff893-9a3f-4894-853c-ff077cfe279b" name="MetalRootLayout" visibility="private" clientDependency="a4057b95-6f21-4ce4-8445-a61839f768ea">
                  <ownedComment xmi:id="727bbd42-e167-4e5a-94a3-c7d2baeaa491" body="A custom layout manager that is responsible for the layout of&#xA;layeredPane, glassPane, menuBar and titlePane, if one has been&#xA;installed.&#xA;" annotatedElement="368ff893-9a3f-4894-853c-ff077cfe279b"/>
                  <interfaceRealization xmi:id="a4057b95-6f21-4ce4-8445-a61839f768ea" name="" supplier="e48fbebc-b4e8-4ac6-ade6-97d72ee70c33" client="368ff893-9a3f-4894-853c-ff077cfe279b" contract="e48fbebc-b4e8-4ac6-ade6-97d72ee70c33"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="7929dabf-52d2-40fe-b07b-509b1a7e2313" name="MouseInputHandler" visibility="private" clientDependency="50b033bc-2c3a-4da5-af32-9087cbeef2da">
                  <ownedComment xmi:id="c430ec9b-3030-46a7-99d5-15aee77acbfd" body="MouseInputHandler is responsible for handling resize/moving of&#xA;the Window. It sets the cursor directly on the Window when then&#xA;mouse moves over a hot spot.&#xA;" annotatedElement="7929dabf-52d2-40fe-b07b-509b1a7e2313"/>
                  <interfaceRealization xmi:id="50b033bc-2c3a-4da5-af32-9087cbeef2da" name="" supplier="5ac087af-8d6f-4dda-ae99-d3ce09f6d53f" client="7929dabf-52d2-40fe-b07b-509b1a7e2313" contract="5ac087af-8d6f-4dda-ae99-d3ce09f6d53f"/>
                </nestedClassifier>
              </packagedElement>
