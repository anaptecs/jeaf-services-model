                <ownedComment xmi:id="cde87794-24a6-47ac-afa1-c8650aa75cc0" body="Node class that matches a POSIX type.&#xA;" annotatedElement="4d8f699e-2171-45e0-ae30-84aa892f75a1"/>
                <generalization xmi:id="ddf9e285-f89e-47e1-ad16-5a779c22ce0f" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="cda13423-5af7-4b87-a94f-f223a74f98c4" name="NotCtype" visibility="package" isLeaf="true">
                <generalization xmi:id="198deffe-058b-4b5b-9cc6-abff5e4a65bd" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="b96de5d7-5c94-43d6-ab69-d246f162cb60" name="Specials" visibility="package" isLeaf="true">
                <generalization xmi:id="d83af72e-965e-47f3-ad53-d38d2d8cdafc" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
