              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="a9a70b4c-a4ae-4563-ac27-f76ffdee437e" isSubstitutable="true" general="f260c380-1b68-4028-8e82-941a4ae34bc1"/>
