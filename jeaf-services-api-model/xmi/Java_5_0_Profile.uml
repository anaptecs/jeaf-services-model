                  <ownedComment xmi:id="e065b388-1dcb-493a-aaa8-fe923bbaba8b" body="An Enumeration of the Attribute names in a MuxingAttributeSet.&#xA;This may return the same name more than once.&#xA;" annotatedElement="1f0b934f-fcfc-4ad1-bd5a-25d044a26e3f"/>
                  <interfaceRealization xmi:id="1186bbee-eed3-4c86-a010-85fa5d418f87" name="" supplier="e83c5e60-f8da-41f9-a241-81435cf4e1c9" client="1f0b934f-fcfc-4ad1-bd5a-25d044a26e3f" contract="e83c5e60-f8da-41f9-a241-81435cf4e1c9"/>
                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="676d7ecf-75b4-4936-835f-677d4fbfe057" name="Option">
                <ownedComment xmi:id="6319560a-cf4e-42bf-8b41-776f3b04af80" body="Value for the ListModel used to represent&#xA;&lt;option> elements.  This is the object&#xA;installed as items of the DefaultComboBoxModel&#xA;used to represent the &lt;select> element.&#xA;&#xA;@author  Timothy Prinzing&#xA;@version 1.10 12/19/03&#xA;" annotatedElement="676d7ecf-75b4-4936-835f-677d4fbfe057"/>
