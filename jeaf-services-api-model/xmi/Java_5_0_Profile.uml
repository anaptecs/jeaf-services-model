            <packagedElement xmi:type="uml:Class" xmi:id="ebe54766-7e35-4928-a6fc-3ba791d56a2b" name="EncodedKeySpec" clientDependency="67c89ed5-721d-4364-9f0f-d455bdbdfa24" isAbstract="true">
              <ownedComment xmi:id="7217dc04-8c0e-4930-9138-b7da4c9c959a" body="This class represents a public or private key in encoded format.&#xA;&#xA;@author Jan Luehe&#xA;&#xA;@version 1.20, 12/19/03&#xA;&#xA;@see java.security.Key&#xA;@see java.security.KeyFactory&#xA;@see KeySpec&#xA;@see X509EncodedKeySpec&#xA;@see PKCS8EncodedKeySpec&#xA;&#xA;@since 1.2&#xA;" annotatedElement="ebe54766-7e35-4928-a6fc-3ba791d56a2b"/>
