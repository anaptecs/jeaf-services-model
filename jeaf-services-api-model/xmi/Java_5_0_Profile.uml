            <packagedElement xmi:type="uml:Class" xmi:id="b41cbd17-5699-4bce-8f88-ef9121b17f63" name="ExecutionException">
              <ownedComment xmi:id="5dc466d5-433f-4d53-9dea-f3de46e895fc" body="Exception thrown when attempting to retrieve the result of a task&#xA;that aborted by throwing an exception. This exception can be&#xA;inspected using the {@link #getCause()} method.&#xA;&#xA;@see Future&#xA;@since 1.5&#xA;@author Doug Lea&#xA;" annotatedElement="b41cbd17-5699-4bce-8f88-ef9121b17f63"/>
              <generalization xmi:id="0046ecb5-9531-4164-8187-696532a7202d" isSubstitutable="true" general="694855d6-ae40-4109-8cc9-66032f8a0dd4"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="2c9b19d5-5b20-483e-aa53-e4903876bdd8" name="Map&lt;K, V>">
              <templateBinding xmi:id="f9b33cf3-5993-4196-a630-ad9194b4be52" signature="9dae8f2c-984e-44b4-8d4e-a5edac1f8640">
                <parameterSubstitution xmi:id="1bf401fb-49fa-448d-93fa-e5aa9ef363a6" formal="9782c0d5-269d-4e47-9906-1ff79d6d273f" actual="296212b1-028b-4ced-b843-87ef00acf92c"/>
                <parameterSubstitution xmi:id="1bb2e0a0-893d-4bb9-9034-a5e41b31d780" formal="855e97da-682f-4e52-bad2-22b7dca1bb1e" actual="07980ef4-f92c-4061-adbc-7f29cc427278"/>
