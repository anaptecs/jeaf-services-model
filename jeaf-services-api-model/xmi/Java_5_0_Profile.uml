                  </ownedParameter>
                </ownedTemplateSignature>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="27b7af77-560b-4d4d-81cb-bda3399f742e" name="Segment" visibility="package" clientDependency="119677f4-a121-4bb9-92ba-d2eada37fbda" isLeaf="true">
                <ownedComment xmi:id="5013e8c4-d2f6-4a57-8d7f-d4f0e0c4f275" body="Segments are specialized versions of hash tables.  This&#xA;subclasses from ReentrantLock opportunistically, just to&#xA;simplify some locking and avoid separate construction.&#xA;" annotatedElement="27b7af77-560b-4d4d-81cb-bda3399f742e"/>
