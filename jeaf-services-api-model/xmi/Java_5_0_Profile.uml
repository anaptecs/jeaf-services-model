                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="6c176898-a65f-450a-91bf-f8d198dd0209" name="TableElementInfo" visibility="private" clientDependency="bd488a4d-1034-4370-99f6-3c7b90ec4804">
                  <ownedComment xmi:id="78c6c286-ba10-4751-84ab-f0cf7741914b" body="TableElementInfo encapsulates information about a HTML.Tag.TABLE.&#xA;To make access fast it crates a grid containing the children to&#xA;allow for access by row, column. TableElementInfo will contain&#xA;TableRowElementInfos, which will contain TableCellElementInfos.&#xA;Any time one of the rows or columns becomes invalid the table is&#xA;invalidated.  This is because any time one of the child attributes&#xA;changes the size of the grid may have changed.&#xA;" annotatedElement="6c176898-a65f-450a-91bf-f8d198dd0209"/>
                  <generalization xmi:id="ffbd9329-ae66-4cae-b573-59fc60e16b52" isSubstitutable="true" general="2d5f4ebb-f727-4e45-b6e6-37065937dec7"/>
                  <interfaceRealization xmi:id="bd488a4d-1034-4370-99f6-3c7b90ec4804" name="" supplier="141a97ab-4748-4027-bbeb-013ccfee2412" client="6c176898-a65f-450a-91bf-f8d198dd0209" contract="141a97ab-4748-4027-bbeb-013ccfee2412"/>
