          <packagedElement xmi:type="uml:Class" xmi:id="ba510f80-0619-4af9-8943-a1113eb5c558" name="LegacyLayoutFocusTraversalPolicy" visibility="package" isLeaf="true">
            <generalization xmi:id="2699ecef-2a5a-4c2a-b968-754b834e9777" isSubstitutable="true" general="85025ddb-64e4-4df9-ad6d-c9ef996449f7"/>
