              <packagedElement xmi:type="uml:Class" xmi:id="59eab067-51c4-4b4d-ab33-6014c392005f" name="DefaultSynthStyleFactory" visibility="package">
                <ownedComment xmi:id="ef73caa9-65b9-4c65-adc1-9279c7573b73" body="Factory used for obtaining styles. Supports associating a style based on&#xA;the name of the component as returned by &lt;code>Component.getName()&lt;/code>,&#xA;and the &lt;code>Region&lt;/code> associated with the &lt;code>JComponent&lt;/code>.&#xA;Lookup is done using regular expressions.&#xA;&#xA;@version 1.6, 12/19/03&#xA;@author Scott Violet&#xA;" annotatedElement="59eab067-51c4-4b4d-ab33-6014c392005f"/>
