            <nestedClassifier xmi:type="uml:Class" xmi:id="f9a9c1a0-c20c-41ea-88d2-38d488d6452c" name="AccessibleJToggleButton" visibility="protected" clientDependency="6345c287-ee6c-4bd3-adc5-8e678a672545">
