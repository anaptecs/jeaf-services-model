            <packagedElement xmi:type="uml:Interface" xmi:id="c15f09d2-f40b-4615-b516-ffeea92fbc2a" name="Enumeration&lt;V>">
              <templateBinding xmi:id="7a49870f-5f45-4aaf-b108-44fa824bb4df" signature="fa83c403-f0a6-4490-9b12-eadf08ca56e7">
                <parameterSubstitution xmi:id="6a020dd3-31c9-4ed5-a871-259f6c11e996" formal="2e2696b8-d504-4a36-a521-4a5443b8abd9" actual="9a137174-2e85-4d98-b83f-272d4eababbf"/>
