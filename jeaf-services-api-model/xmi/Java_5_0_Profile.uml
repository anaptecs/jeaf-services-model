          <packagedElement xmi:type="uml:Interface" xmi:id="eeeb1ab5-e12a-4c21-b5bc-ec75104c825e" name="Renderer" isAbstract="true">
            <ownedComment xmi:id="d8393f5e-96ee-47fb-843b-ad10330817f7" body="Defines the requirements for an object responsible for&#xA;&quot;rendering&quot; (displaying) a value.&#xA;&#xA;@version 1.12 12/19/03&#xA;@author Arnaud Weber&#xA;" annotatedElement="eeeb1ab5-e12a-4c21-b5bc-ec75104c825e"/>
