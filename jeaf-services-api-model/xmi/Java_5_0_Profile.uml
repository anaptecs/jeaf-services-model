                <nestedClassifier xmi:type="uml:Class" xmi:id="33d472e9-f0fe-4616-890c-7bcc1edf4a7c" name="WriteLock" clientDependency="bb19b64a-2dc9-442c-955e-b92e918a99a9 91ff93ab-4901-4d7d-863a-adaa120e9f29">
                  <ownedComment xmi:id="7877b897-5eab-47f6-a956-b177d7c55f00" body="The lock returned by method {@link ReentrantReadWriteLock#writeLock}.&#xA;" annotatedElement="33d472e9-f0fe-4616-890c-7bcc1edf4a7c"/>
                  <interfaceRealization xmi:id="bb19b64a-2dc9-442c-955e-b92e918a99a9" name="" supplier="a596440a-85e0-4f09-a6d5-2059577833d8" client="33d472e9-f0fe-4616-890c-7bcc1edf4a7c" contract="a596440a-85e0-4f09-a6d5-2059577833d8"/>
                  <interfaceRealization xmi:id="91ff93ab-4901-4d7d-863a-adaa120e9f29" name="" supplier="f68aec46-50b5-48d7-b5b4-79aa18484c4c" client="33d472e9-f0fe-4616-890c-7bcc1edf4a7c" contract="f68aec46-50b5-48d7-b5b4-79aa18484c4c"/>
                </nestedClassifier>
