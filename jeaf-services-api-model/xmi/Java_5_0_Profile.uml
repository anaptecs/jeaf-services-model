            <nestedClassifier xmi:type="uml:Class" xmi:id="60de1697-bebf-44a9-8980-200f14b5b07b" name="SimpleEntry" visibility="package" clientDependency="a8071acc-f66d-4330-8acf-cf0e654a7129">
              <ownedComment xmi:id="a373ddca-e25b-4f9c-a70e-5087b185a80c" body="This should be made public as soon as possible.  It greatly simplifies&#xA;the task of implementing Map.&#xA;" annotatedElement="60de1697-bebf-44a9-8980-200f14b5b07b"/>
