            <nestedClassifier xmi:type="uml:Class" xmi:id="953ba5ab-e4f9-4422-9e24-acec0978ecfb" name="Enumerator" visibility="private" clientDependency="8f35e7b2-596b-4eed-9024-16ce31d0f944 f0ed8d95-5752-4aa9-a161-adc90570147d">
              <ownedComment xmi:id="05425e88-a74b-476f-bbaf-8c17e383d494" body="A hashtable enumerator class.  This class implements both the&#xA;Enumeration and Iterator interfaces, but individual instances&#xA;can be created with the Iterator methods disabled.  This is necessary&#xA;to avoid unintentionally increasing the capabilities granted a user&#xA;by passing an Enumeration.&#xA;" annotatedElement="953ba5ab-e4f9-4422-9e24-acec0978ecfb"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="a741d17e-d056-4aa8-9a57-cc26604a443c" name="" parameter="6f2a4150-2303-4477-8339-94a3d74b2154">
