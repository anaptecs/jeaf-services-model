          <packagedElement xmi:type="uml:Class" xmi:id="c3497abb-c440-411a-8ad5-9647dd4e0dac" name="SocketImpl" clientDependency="0e5b83b4-d2f2-474b-ac88-f29c093b2f60" isAbstract="true">
            <ownedComment xmi:id="f1b4adc3-efcb-4d0d-b87d-387a2ddfdead" body="The abstract class &lt;code>SocketImpl&lt;/code> is a common superclass&#xA;of all classes that actually implement sockets. It is used to&#xA;create both client and server sockets.&#xA;&lt;p>&#xA;A &quot;plain&quot; socket implements these methods exactly as&#xA;described, without attempting to go through a firewall or proxy.&#xA;&#xA;@author  unascribed&#xA;@version 1.42, 03/25/04&#xA;@since   JDK1.0&#xA;" annotatedElement="c3497abb-c440-411a-8ad5-9647dd4e0dac"/>
            <interfaceRealization xmi:id="0e5b83b4-d2f2-474b-ac88-f29c093b2f60" name="" supplier="3f114887-c6e0-4ff6-ac04-53d05eefdf43" client="c3497abb-c440-411a-8ad5-9647dd4e0dac" contract="3f114887-c6e0-4ff6-ac04-53d05eefdf43"/>
