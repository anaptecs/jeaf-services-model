                <ownedComment xmi:id="1c9fd5cd-9678-4763-b0c8-39be2907a45c" body="Node class for a case sensitive sequence of literal characters.&#xA;" annotatedElement="8c16a047-e3f3-435b-9eb1-3562c7a42043"/>
                <generalization xmi:id="305231b5-e04f-45f5-8461-26f0ea589282" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="84b601c9-4274-435f-aeac-418391457ff4" name="SliceA" visibility="package" isLeaf="true">
                <ownedComment xmi:id="f89b23eb-62eb-45ad-bbf8-671d1d59722c" body="Node class for a case insensitive sequence of literal characters.&#xA;" annotatedElement="84b601c9-4274-435f-aeac-418391457ff4"/>
                <generalization xmi:id="dae7a306-38d3-42a9-b6d0-384ad1266fa0" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="4d2c3fa6-2e9e-469b-9428-d45fa9628a6a" name="SliceU" visibility="package" isLeaf="true">
                <ownedComment xmi:id="79c9daaa-7d69-4237-86eb-ed8b82c3ea6c" body="Node class for a case insensitive sequence of literal characters.&#xA;Uses unicode case folding.&#xA;" annotatedElement="4d2c3fa6-2e9e-469b-9428-d45fa9628a6a"/>
                <generalization xmi:id="2b17e034-c90d-4b14-8c2f-261a12cea2cd" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="ce9e6d61-8cb3-4095-b080-00b0db31ba0e" name="Range" visibility="package">
                <ownedComment xmi:id="749a1b45-0121-46aa-a0c6-f0bbad0d19a8" body="Node class for matching characters within an explicit value range.&#xA;" annotatedElement="ce9e6d61-8cb3-4095-b080-00b0db31ba0e"/>
                <generalization xmi:id="360efbd4-e07b-449c-b7f0-899d5893de85" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="dffaa09f-9266-4898-ba9d-a07838d0b98f" name="CIRange" visibility="package" isLeaf="true">
                <ownedComment xmi:id="22dea49a-bfb5-40c5-a1fc-696a6cb0eddb" body="Node class for matching characters within an explicit value range&#xA;in a case insensitive manner.&#xA;" annotatedElement="dffaa09f-9266-4898-ba9d-a07838d0b98f"/>
                <generalization xmi:id="1d57ed41-b439-4e85-b7aa-052e2c9d705b" isSubstitutable="true" general="ce9e6d61-8cb3-4095-b080-00b0db31ba0e"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="fe5a2ecc-a870-4f06-bcd7-eb13d277de4c" name="NotRange" visibility="package">
                <generalization xmi:id="94e11089-e2d2-4549-96cf-e14afe7ec76a" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="08716d01-2b21-43d8-8f7f-07b99af23d10" name="CINotRange" visibility="package">
                <generalization xmi:id="dcc853f6-0446-4bf2-886f-e7a08c106297" isSubstitutable="true" general="fe5a2ecc-a870-4f06-bcd7-eb13d277de4c"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="8c574245-5cb9-419f-b560-a1dec2661844" name="All" visibility="package" isLeaf="true">
                <ownedComment xmi:id="2568e897-2fb0-4fb8-8e3d-ab5de7e24089" body="Implements the Unicode category ALL and the dot metacharacter when&#xA;in dotall mode.&#xA;" annotatedElement="8c574245-5cb9-419f-b560-a1dec2661844"/>
                <generalization xmi:id="4a654fd9-8e1f-48e8-93a3-208974941542" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="2d1d4a04-b27d-4d51-b70e-3828e46e5214" name="Dot" visibility="package" isLeaf="true">
                <ownedComment xmi:id="5794458b-4077-4d6a-ab46-0b1fca54c6d9" body="Node class for the dot metacharacter when dotall is not enabled.&#xA;" annotatedElement="2d1d4a04-b27d-4d51-b70e-3828e46e5214"/>
                <generalization xmi:id="72148d5f-80fc-41b4-bc63-090bd2d20c22" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="114243c8-340c-4303-8ce4-d7e639da89ed" name="UnixDot" visibility="package" isLeaf="true">
                <ownedComment xmi:id="10ad76ae-e6ff-47e7-88f4-dd3484ffdde0" body="Node class for the dot metacharacter when dotall is not enabled&#xA;but UNIX_LINES is enabled.&#xA;" annotatedElement="114243c8-340c-4303-8ce4-d7e639da89ed"/>
                <generalization xmi:id="b0b2d600-56d7-459f-912f-2fd5ef7cb239" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="8b1ebe81-618f-49f8-a2b0-f40103c124df" name="Ques" visibility="package" isLeaf="true">
                <ownedComment xmi:id="c5b6f796-d60d-40ec-be37-b9e95e274065" body="The 0 or 1 quantifier. This one class implements all three types.&#xA;" annotatedElement="8b1ebe81-618f-49f8-a2b0-f40103c124df"/>
                <generalization xmi:id="4b3c1768-f193-4214-b7df-da37b49fa5b0" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="1927d30a-856b-4119-b2e9-48bd294cded4" name="Curly" visibility="package" isLeaf="true">
                <ownedComment xmi:id="3cef705c-fe07-4ce0-9f57-a299aff455ee" body="Handles the curly-brace style repetition with a specified minimum and&#xA;maximum occurrences. The * quantifier is handled as a special case.&#xA;This class handles the three types.&#xA;" annotatedElement="1927d30a-856b-4119-b2e9-48bd294cded4"/>
                <generalization xmi:id="54996ed8-061f-4c86-8495-97c3dbd5a99e" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="f55e3c4e-01c7-48d6-bc06-30313f21d3f7" name="GroupCurly" visibility="package" isLeaf="true">
                <ownedComment xmi:id="68241e91-0534-4fb0-a42d-df3ba6b6e75b" body="Handles the curly-brace style repetition with a specified minimum and&#xA;maximum occurrences in deterministic cases. This is an iterative&#xA;optimization over the Prolog and Loop system which would handle this&#xA;in a recursive way. The * quantifier is handled as a special case.&#xA;If capture is true then this class saves group settings and ensures&#xA;that groups are unset when backing off of a group match.&#xA;" annotatedElement="f55e3c4e-01c7-48d6-bc06-30313f21d3f7"/>
                <generalization xmi:id="d6289a42-2ad6-4a97-9244-2c7f3f4d802c" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="c6b70152-6b42-42e7-bd1c-7ce87c645eb6" name="Branch" visibility="package" isLeaf="true">
                <ownedComment xmi:id="bfb699b6-3433-4f09-9f07-e1a7ea29b2a3" body="Handles the branching of alternations. Note this is also used for&#xA;the ? quantifier to branch between the case where it matches once&#xA;and where it does not occur.&#xA;" annotatedElement="c6b70152-6b42-42e7-bd1c-7ce87c645eb6"/>
                <generalization xmi:id="cc63db20-169b-472f-87a7-6e1c29a62121" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="96eb0b5c-280d-44b0-9bbc-b0d64d94a300" name="GroupHead" visibility="package" isLeaf="true">
                <ownedComment xmi:id="340544fd-d977-4b27-83d2-76b2dbdf5292" body="The GroupHead saves the location where the group begins in the locals&#xA;and restores them when the match is done.&#xA;&#xA;The matchRef is used when a reference to this group is accessed later&#xA;in the expression. The locals will have a negative value in them to&#xA;indicate that we do not want to unset the group if the reference&#xA;doesn't match.&#xA;" annotatedElement="96eb0b5c-280d-44b0-9bbc-b0d64d94a300"/>
                <generalization xmi:id="cd9f02ef-0ef6-4e13-ad8a-97bf9d6a16e8" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="6bed0a48-9083-45a4-985f-f03dbcba5981" name="GroupRef" visibility="package" isLeaf="true">
                <ownedComment xmi:id="dac8d830-157a-4a78-bdfe-cdcc8ff287de" body="Recursive reference to a group in the regular expression. It calls&#xA;matchRef because if the reference fails to match we would not unset&#xA;the group.&#xA;" annotatedElement="6bed0a48-9083-45a4-985f-f03dbcba5981"/>
                <generalization xmi:id="21e5b2f9-1d51-4da7-b997-f0d7993b24cc" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="1abf898c-9a63-48ec-96a0-8ff8acf99f50" name="GroupTail" visibility="package" isLeaf="true">
                <ownedComment xmi:id="1a4f9ba8-3de0-4b7d-9d51-59390ac82ce9" body="The GroupTail handles the setting of group beginning and ending&#xA;locations when groups are successfully matched. It must also be able to&#xA;unset groups that have to be backed off of.&#xA;&#xA;The GroupTail node is also used when a previous group is referenced,&#xA;and in that case no group information needs to be set.&#xA;" annotatedElement="1abf898c-9a63-48ec-96a0-8ff8acf99f50"/>
                <generalization xmi:id="2d48d2d0-9131-40ff-bfdb-62eb9a1c0c87" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="886461dc-2f4c-4795-8669-4acfcd42bf3b" name="Prolog" visibility="package" isLeaf="true">
                <ownedComment xmi:id="73cae850-f00a-4204-8c20-2e2d26ddb75d" body="This sets up a loop to handle a recursive quantifier structure.&#xA;" annotatedElement="886461dc-2f4c-4795-8669-4acfcd42bf3b"/>
                <generalization xmi:id="0dbaf2e2-ae1c-4ca4-8249-376a568b9f2e" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="c03b518b-bc7a-4512-881b-0661c80e25cf" name="Loop" visibility="package">
                <ownedComment xmi:id="23affcb2-8526-4ed7-905f-886dc9e329e5" body="Handles the repetition count for a greedy Curly. The matchInit&#xA;is called from the Prolog to save the index of where the group&#xA;beginning is stored. A zero length group check occurs in the&#xA;normal match but is skipped in the matchInit.&#xA;" annotatedElement="c03b518b-bc7a-4512-881b-0661c80e25cf"/>
                <generalization xmi:id="ab39859c-690f-4176-87bf-05c453b24a87" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="73831657-88cb-4133-ab30-1144e4c59b9d" name="LazyLoop" visibility="package" isLeaf="true">
                <ownedComment xmi:id="e870306b-06ae-42eb-b447-6fa790c35284" body="Handles the repetition count for a reluctant Curly. The matchInit&#xA;is called from the Prolog to save the index of where the group&#xA;beginning is stored. A zero length group check occurs in the&#xA;normal match but is skipped in the matchInit.&#xA;" annotatedElement="73831657-88cb-4133-ab30-1144e4c59b9d"/>
                <generalization xmi:id="44ef448a-8041-4e5f-86ad-569edf668cea" isSubstitutable="true" general="c03b518b-bc7a-4512-881b-0661c80e25cf"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="c6db2daa-a183-4b24-9e7c-1d04c03cffee" name="BackRef" visibility="package">
                <ownedComment xmi:id="f64e1fd6-0291-425b-b82f-d0452e90f82c" body="Refers to a group in the regular expression. Attempts to match&#xA;whatever the group referred to last matched.&#xA;" annotatedElement="c6db2daa-a183-4b24-9e7c-1d04c03cffee"/>
                <generalization xmi:id="cb5e6d09-7f8e-4268-b38f-607404fccdbb" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="948b0272-357b-4bf4-9be7-e3cd9f8c8a9d" name="CIBackRef" visibility="package">
                <generalization xmi:id="1f2cf60c-0a2c-4190-afb1-3931838b3ee9" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="acc4df4a-d1c2-4aed-a3e8-7b1fdc5ee120" name="First" visibility="package" isLeaf="true">
                <ownedComment xmi:id="c4d4f0a8-856e-40c0-bfea-bb258150fd12" body="Searches until the next instance of its atom. This is useful for&#xA;finding the atom efficiently without passing an instance of it&#xA;(greedy problem) and without a lot of wasted search time (reluctant&#xA;problem).&#xA;" annotatedElement="acc4df4a-d1c2-4aed-a3e8-7b1fdc5ee120"/>
                <generalization xmi:id="afb824e1-9017-4ffa-8650-b4c69d0d487a" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="c90b4c7a-427f-48b8-8698-4cbc0331b239" name="Conditional" visibility="package" isLeaf="true">
                <generalization xmi:id="577eedc7-6554-4c5c-97be-8e1bc0117d11" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="f90fbcb3-00a7-4cc9-983c-ffe791207935" name="Pos" visibility="package" isLeaf="true">
                <ownedComment xmi:id="7fb5b8db-4383-4e44-967c-f043fbf40395" body="Zero width positive lookahead.&#xA;" annotatedElement="f90fbcb3-00a7-4cc9-983c-ffe791207935"/>
                <generalization xmi:id="9ce045f5-fbd5-462a-a58c-91b500b86d26" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="fe51dfb5-63c4-4ac6-9621-c3ac829e0f0e" name="Neg" visibility="package" isLeaf="true">
                <ownedComment xmi:id="0633392a-7dcf-464b-8b01-8ee363d00373" body="Zero width negative lookahead.&#xA;" annotatedElement="fe51dfb5-63c4-4ac6-9621-c3ac829e0f0e"/>
                <generalization xmi:id="4e40ba0a-4c5e-49c2-9e6f-2d14f11eba9e" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="f5d33f8a-377e-4e39-a2f7-78b8814ec242" name="Behind" visibility="package">
                <ownedComment xmi:id="8fad41ac-e964-43d7-92db-229a06ea1438" body="Zero width positive lookbehind.&#xA;" annotatedElement="f5d33f8a-377e-4e39-a2f7-78b8814ec242"/>
                <generalization xmi:id="fcb8133f-4578-47ec-a050-49a76379bf5c" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="13733a69-2f60-4e5d-b9df-d83bcc6b2b18" name="NotBehind" visibility="package">
                <ownedComment xmi:id="e63ba54f-63d7-49b6-ae9b-a94e622a3583" body="Zero width negative lookbehind.&#xA;" annotatedElement="13733a69-2f60-4e5d-b9df-d83bcc6b2b18"/>
                <generalization xmi:id="a219b6da-890c-4011-b023-01894d0cd2b2" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="1a7ec9c9-11e5-4bd5-a31a-90dafb1d1814" name="Add" visibility="package">
                <ownedComment xmi:id="ea61ad55-502b-4697-850c-133eaecb98d9" body="An object added to the tree when a character class has an additional&#xA;range added to it.&#xA;" annotatedElement="1a7ec9c9-11e5-4bd5-a31a-90dafb1d1814"/>
                <generalization xmi:id="8e509ff4-d058-413e-9480-1bb8a5f90ba9" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="9f9d9cb8-0e20-44a5-9474-173acb78de9f" name="Both" visibility="package">
                <ownedComment xmi:id="566bc75c-c68c-4a2b-853e-0ee47e9c09fe" body="An object added to the tree when a character class has another&#xA;nested class in it.&#xA;" annotatedElement="9f9d9cb8-0e20-44a5-9474-173acb78de9f"/>
                <generalization xmi:id="73dfa7b8-6875-492f-be18-5fc57e9da930" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="743528de-cfa2-4da0-a37d-98c634b05f78" name="Sub" visibility="package" isLeaf="true">
                <ownedComment xmi:id="6af884d1-99e3-40fd-a065-54008cb83046" body="An object added to the tree when a character class has a range&#xA;or single subtracted from it.&#xA;" annotatedElement="743528de-cfa2-4da0-a37d-98c634b05f78"/>
                <generalization xmi:id="93841769-3c41-4b8c-bc2c-ba126bdc5681" isSubstitutable="true" general="1a7ec9c9-11e5-4bd5-a31a-90dafb1d1814"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="c1bd0cf7-09f2-4182-a62c-0f812f115644" name="Bound" visibility="package" isLeaf="true">
                <ownedComment xmi:id="4b3e7ddf-63ea-43eb-8f2e-77229618cae5" body="Handles word boundaries. Includes a field to allow this one class to&#xA;deal with the different types of word boundaries we can match. The word&#xA;characters include underscores, letters, and digits. Non spacing marks&#xA;can are also part of a word if they have a base character, otherwise&#xA;they are ignored for purposes of finding word boundaries.&#xA;" annotatedElement="c1bd0cf7-09f2-4182-a62c-0f812f115644"/>
                <generalization xmi:id="eb529132-7837-431b-8dc9-4f36b73dc7ad" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="5712a130-3491-4a2c-ab74-e0c001e438cf" name="BnM" visibility="package">
                <ownedComment xmi:id="de9f7dc3-d3ca-4f1f-883d-43a9d4d1a38f" body="Attempts to match a slice in the input using the Boyer-Moore string&#xA;matching algorithm. The algorithm is based on the idea that the&#xA;pattern can be shifted farther ahead in the search text if it is&#xA;matched right to left.&#xA;&lt;p>&#xA;The pattern is compared to the input one character at a time, from&#xA;the rightmost character in the pattern to the left. If the characters&#xA;all match the pattern has been found. If a character does not match,&#xA;the pattern is shifted right a distance that is the maximum of two&#xA;functions, the bad character shift and the good suffix shift. This&#xA;shift moves the attempted match position through the input more&#xA;quickly than a naive one position at a time check.&#xA;&lt;p>&#xA;The bad character shift is based on the character from the text that&#xA;did not match. If the character does not appear in the pattern, the&#xA;pattern can be shifted completely beyond the bad character. If the&#xA;character does occur in the pattern, the pattern can be shifted to&#xA;line the pattern up with the next occurrence of that character.&#xA;&lt;p>&#xA;The good suffix shift is based on the idea that some subset on the right&#xA;side of the pattern has matched. When a bad character is found, the&#xA;pattern can be shifted right by the pattern length if the subset does&#xA;not occur again in pattern, or by the amount of distance to the&#xA;next occurrence of the subset in the pattern.&#xA;&#xA;Boyer-Moore search methods adapted from code by Amy Yu.&#xA;" annotatedElement="5712a130-3491-4a2c-ab74-e0c001e438cf"/>
                <generalization xmi:id="e9c5934a-cbc9-4d8b-96f4-772476f202cc" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="b684d44e-cc2e-40c5-9e47-18f9e3362339" name="StartS" visibility="package" isLeaf="true">
                <generalization xmi:id="3c41821b-6cf1-4e71-a8d8-5060926c8a1e" isSubstitutable="true" general="4fe615b8-706c-4409-b831-0afdfc893822"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="cd69d53a-bad5-434a-a819-de2ff40b1eb5" name="JavaTypeClass" visibility="package" isAbstract="true">
                <generalization xmi:id="2fd4660f-0a08-4663-8a83-759aa8061b9d" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="f4d3fb81-f451-4a88-96b9-6b1c4d815e71" name="JavaLowerCase" visibility="package" isLeaf="true">
                <generalization xmi:id="8f1c018a-20c7-499a-8f6e-c2e8f3b6a443" isSubstitutable="true" general="cd69d53a-bad5-434a-a819-de2ff40b1eb5"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="648ddd4d-eab4-4272-9d0e-5a61330edd0c" name="JavaUpperCase" visibility="package" isLeaf="true">
                <generalization xmi:id="8df24024-e2c1-4686-8efe-aa7552d796b9" isSubstitutable="true" general="cd69d53a-bad5-434a-a819-de2ff40b1eb5"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="572a364f-8f30-4fd4-bc3a-97c2b983fde9" name="JavaTitleCase" visibility="package" isLeaf="true">
                <generalization xmi:id="f4d302db-f3ed-40f9-a3d4-0e24b8213332" isSubstitutable="true" general="cd69d53a-bad5-434a-a819-de2ff40b1eb5"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="47982e52-a7e2-419b-afe6-d88cfee90fcb" name="JavaDigit" visibility="package" isLeaf="true">
