          <packagedElement xmi:type="uml:Class" xmi:id="e9b741d8-e639-46f4-adb4-565769f2325e" name="HeapIntBufferR" visibility="package">
            <ownedComment xmi:id="30b4a325-3289-410a-9f00-4f78e7d603ae" body="A read-only HeapIntBuffer.  This class extends the corresponding&#xA;read/write class, overriding the mutation methods to throw a {@link&#xA;ReadOnlyBufferException} and overriding the view-buffer methods to return an&#xA;instance of this class rather than of the superclass.&#xA;" annotatedElement="e9b741d8-e639-46f4-adb4-565769f2325e"/>
