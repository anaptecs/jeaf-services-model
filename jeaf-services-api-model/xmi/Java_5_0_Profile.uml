              <nestedClassifier xmi:type="uml:Class" xmi:id="e900c748-d390-4de9-8bfb-d6ab9662f189" name="BCSChild" visibility="protected" clientDependency="7398239a-8605-49e4-8021-9c6ebb9c53aa">
                <interfaceRealization xmi:id="7398239a-8605-49e4-8021-9c6ebb9c53aa" name="" supplier="f68aec46-50b5-48d7-b5b4-79aa18484c4c" client="e900c748-d390-4de9-8bfb-d6ab9662f189" contract="f68aec46-50b5-48d7-b5b4-79aa18484c4c"/>
              </nestedClassifier>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="b7787830-a7a1-488d-ba5c-07e60c01258e" name="BeanContextChildSupport" clientDependency="44c46f92-1159-41dd-9013-9b547fc3f0a6 faf00dab-9940-42f3-9ec7-78523e06f19f 8ff399c8-d5c8-4025-82ce-5ccf2ca33414">
              <ownedComment xmi:id="2acc33ab-d134-4a53-9069-631ecdb44165" body="&lt;p>&#xA;This is a general support class to provide support for implementing the&#xA;BeanContextChild protocol.&#xA;&#xA;This class may either be directly subclassed, or encapsulated and delegated&#xA;to in order to implement this interface for a given component.&#xA;&lt;/p>&#xA;&#xA;@author&#x9;Laurence P. G. Cable&#xA;@version&#x9;1.16, 03/04/04&#xA;@since&#x9;1.2&#xA;&#xA;@see&#x9;java.beans.beancontext.BeanContext&#xA;@see&#x9;java.beans.beancontext.BeanContextServices&#xA;@see&#x9;java.beans.beancontext.BeanContextChild&#xA;" annotatedElement="b7787830-a7a1-488d-ba5c-07e60c01258e"/>
              <interfaceRealization xmi:id="faf00dab-9940-42f3-9ec7-78523e06f19f" name="" supplier="5d06c470-8d7c-4453-8ee2-0f627ac486bc" client="b7787830-a7a1-488d-ba5c-07e60c01258e" contract="5d06c470-8d7c-4453-8ee2-0f627ac486bc"/>
