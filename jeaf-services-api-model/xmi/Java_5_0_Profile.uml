                <nestedClassifier xmi:type="uml:Class" xmi:id="fc9f7a9a-3e3b-4ae9-b926-9832dee96378" name="PropertyChangeHandler" visibility="protected" clientDependency="d3d0a78d-ef58-4662-9b07-f90640aa06ca">
