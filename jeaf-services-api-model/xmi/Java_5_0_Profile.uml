          <packagedElement xmi:type="uml:Class" xmi:id="d3caa8ba-07b4-4b15-b8bc-7b814db44f3b" name="MatchQueryExp" visibility="package" clientDependency="2c16a988-47e9-4540-88a7-ae2b4f56f896">
