                      <interfaceRealization xmi:id="b7b564a5-4240-4ddc-b505-09c525d0ae43" name="" supplier="78a73b1a-4a37-43e3-931f-1aded6b207bc" client="87cc9df2-ea34-41f4-ae44-e087c9a8170d" contract="78a73b1a-4a37-43e3-931f-1aded6b207bc"/>
