              <nestedClassifier xmi:type="uml:Class" xmi:id="a0ce03d0-fa34-44d1-85b9-200b0aab6c7b" name="BCSSServiceProvider" visibility="protected" clientDependency="ea741528-8fda-4ef2-b255-7191caebb005">
                <ownedComment xmi:id="034ad0b2-6971-41a8-9f15-781b80dcb8f3" body="subclasses may subclass this nested class to add behaviors for&#xA;each BeanContextServicesProvider.&#xA;" annotatedElement="a0ce03d0-fa34-44d1-85b9-200b0aab6c7b"/>
