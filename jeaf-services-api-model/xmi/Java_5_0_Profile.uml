              <nestedClassifier xmi:type="uml:Class" xmi:id="4fffc824-3114-4f7e-a475-f4d96697b45c" name="AccessibleAWTFocusHandler" visibility="protected" clientDependency="8cdc1bc0-966d-4dce-a682-58fd837e257c">
                <ownedComment xmi:id="1088444f-bc79-42b5-b57d-e35d028f9e0e" body="Fire PropertyChange listener, if one is registered,&#xA;when focus events happen&#xA;" annotatedElement="4fffc824-3114-4f7e-a475-f4d96697b45c"/>
                <interfaceRealization xmi:id="8cdc1bc0-966d-4dce-a682-58fd837e257c" name="" supplier="de8ce2cb-c5ee-4e68-9f71-9a0ab48d6398" client="4fffc824-3114-4f7e-a475-f4d96697b45c" contract="de8ce2cb-c5ee-4e68-9f71-9a0ab48d6398"/>
              </nestedClassifier>
