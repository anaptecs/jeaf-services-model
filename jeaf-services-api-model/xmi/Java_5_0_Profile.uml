              <ownedComment xmi:id="d988f311-5b92-4cf7-b933-b3b334fdab45" body="This class implements a stream filter for writing compressed data in&#xA;the GZIP file format.&#xA;@version &#x9;1.22, 12/19/03&#xA;@author &#x9;David Connelly&#xA;&#xA;" annotatedElement="d18b9f50-533c-43f3-8409-c02902d15042"/>
              <generalization xmi:id="946a3885-5afe-4a7a-96c6-d8023511026b" isSubstitutable="true" general="2f0f7097-a1f4-4b7e-83dc-3ee047ac0f58"/>
