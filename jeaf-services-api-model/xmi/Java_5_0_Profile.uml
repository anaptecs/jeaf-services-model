              <nestedClassifier xmi:type="uml:Class" xmi:id="c06e6daf-0700-42a2-be5b-9f25cf2280d1" name="Itr" visibility="private" clientDependency="f2fbb8f1-da43-401b-8859-c54890616ff1">
                <interfaceRealization xmi:id="f2fbb8f1-da43-401b-8859-c54890616ff1" name="" supplier="3953ddc7-5664-488f-b915-a11d5ac3406d" client="c06e6daf-0700-42a2-be5b-9f25cf2280d1" contract="3953ddc7-5664-488f-b915-a11d5ac3406d"/>
