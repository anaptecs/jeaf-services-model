              <nestedClassifier xmi:type="uml:Class" xmi:id="ff684687-c2c3-4af3-9165-b13ca8c9618c" name="Itr" visibility="private" clientDependency="dd966111-a220-4c97-9ca3-701e793e3305">
                <interfaceRealization xmi:id="dd966111-a220-4c97-9ca3-701e793e3305" name="" supplier="3953ddc7-5664-488f-b915-a11d5ac3406d" client="ff684687-c2c3-4af3-9165-b13ca8c9618c" contract="3953ddc7-5664-488f-b915-a11d5ac3406d"/>
