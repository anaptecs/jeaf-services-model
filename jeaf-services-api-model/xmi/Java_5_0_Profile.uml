            <ownedComment xmi:id="ee1c3ad7-2b41-49e4-958e-013a557be118" body="Implements an Enumeration that combines elements from a Set and&#xA;an Enumeration. Used by ListResourceBundle and PropertyResourceBundle.&#xA;" annotatedElement="8276becb-2bd6-4ccf-b80e-2a2b236f766d"/>
