            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="5f22a575-0129-4109-9518-075e927079da" name="AccessibleJTabbedPane" visibility="protected" clientDependency="bb401542-0739-4cd3-b468-76c08c48ba42 b79dcfcc-a4a4-424b-abc3-e16a4fb3f43a">
              <ownedComment xmi:id="d8ff69b5-9770-4360-ab8f-cc4f09f5252c" body="This class implements accessibility support for the&#xA;&lt;code>JTabbedPane&lt;/code> class.  It provides an implementation of the&#xA;Java Accessibility API appropriate to tabbed pane user-interface&#xA;elements.&#xA;&lt;p>&#xA;&lt;strong>Warning:&lt;/strong>&#xA;Serialized objects of this class will not be compatible with&#xA;future Swing releases. The current serialization support is&#xA;appropriate for short term storage or RMI between applications running&#xA;the same version of Swing.  As of 1.4, support for long term storage&#xA;of all JavaBeans&lt;sup>&lt;font size=&quot;-2&quot;>TM&lt;/font>&lt;/sup>&#xA;has been added to the &lt;code>java.beans&lt;/code> package.&#xA;Please see {@link java.beans.XMLEncoder}.&#xA;" annotatedElement="5f22a575-0129-4109-9518-075e927079da"/>
              <generalization xmi:id="9ca00b7f-5127-4c97-b44c-c745d9514498" isSubstitutable="true" general="c18f9b5e-8764-49f0-9979-c2ff2889082d"/>
              <interfaceRealization xmi:id="bb401542-0739-4cd3-b468-76c08c48ba42" name="" supplier="2f22b0b9-2415-4ad8-b8f7-814855a6f56d" client="5f22a575-0129-4109-9518-075e927079da" contract="2f22b0b9-2415-4ad8-b8f7-814855a6f56d"/>
              <interfaceRealization xmi:id="b79dcfcc-a4a4-424b-abc3-e16a4fb3f43a" name="" supplier="7fa702a1-b36f-46ce-84db-f895a45577ee" client="5f22a575-0129-4109-9518-075e927079da" contract="7fa702a1-b36f-46ce-84db-f895a45577ee"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="48bfc088-79a7-4ba3-bfb4-d45a18395d2d" name="Page" visibility="private" clientDependency="03472c43-efe6-40f4-9b75-24d9480900d1 e2507a7b-f883-4182-a013-a336fbf46b66 0db9c3a3-59ee-4ed1-8ecb-2d992d98952d">
              <generalization xmi:id="a01e449a-1c3f-45fc-afbb-b3a842795ed0" isSubstitutable="true" general="308ea4ff-280f-4a99-86df-eadb9c5565e5"/>
              <interfaceRealization xmi:id="e2507a7b-f883-4182-a013-a336fbf46b66" name="" supplier="f68aec46-50b5-48d7-b5b4-79aa18484c4c" client="48bfc088-79a7-4ba3-bfb4-d45a18395d2d" contract="f68aec46-50b5-48d7-b5b4-79aa18484c4c"/>
