                <interfaceRealization xmi:id="d6293d27-5725-4306-bcdc-7b1c6c905999" name="" supplier="de8ce2cb-c5ee-4e68-9f71-9a0ab48d6398" client="b02a7cf6-10fa-43c4-aaaa-3eb5fbd8d33e" contract="de8ce2cb-c5ee-4e68-9f71-9a0ab48d6398"/>
