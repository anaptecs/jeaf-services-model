              <nestedClassifier xmi:type="uml:Class" xmi:id="4f69c19a-c492-4496-bb6b-bc196dd928db" name="EntryIterator" visibility="package" clientDependency="1d3f0c2a-fcbe-4832-8560-11c19e174508 5e7009b7-8631-4d31-ad5f-ffe05664bb1c 9e07f356-9721-4531-bdb6-42388b41a7e1" isLeaf="true">
                <ownedComment xmi:id="f1573f30-b333-428e-8fab-bbc746885059" body="Entry iterator. Exported Entry objects must write-through&#xA;changes in setValue, even if the nodes have been cloned. So we&#xA;cannot return internal HashEntry objects. Instead, the iterator&#xA;itself acts as a forwarding pseudo-entry.&#xA;" annotatedElement="4f69c19a-c492-4496-bb6b-bc196dd928db"/>
