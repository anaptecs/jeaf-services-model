            <generalization xmi:id="fbda634a-09b5-4c29-af70-0c6373c88891" isSubstitutable="true" general="6dd5b5f1-9534-40b3-9acf-4df1e8508462"/>
            <nestedClassifier xmi:type="uml:Class" xmi:id="547bb61d-08d2-42fd-8322-1a46a77e7003" name="MultiUIDefaultsEnumerator" visibility="private" clientDependency="002a74cc-701d-4886-b999-25c4c8c18f3c">
              <interfaceRealization xmi:id="002a74cc-701d-4886-b999-25c4c8c18f3c" name="" supplier="e83c5e60-f8da-41f9-a241-81435cf4e1c9" client="547bb61d-08d2-42fd-8322-1a46a77e7003" contract="e83c5e60-f8da-41f9-a241-81435cf4e1c9"/>
