          <packagedElement xmi:type="uml:Interface" xmi:id="f5630fc4-d8b3-4822-b7bf-7006ce455456" name="Comparable&lt;Calendar>">
            <templateBinding xmi:id="69fd31f4-c19f-449d-9a29-24c8e8d25875" signature="090eff04-654e-4939-a618-5fadf2a459dc">
