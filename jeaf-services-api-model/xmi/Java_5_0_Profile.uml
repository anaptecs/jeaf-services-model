                  <generalization xmi:id="789366a1-bdae-4239-accd-8b181185120c" isSubstitutable="true" general="786d418d-4ee1-4d97-b21d-0f131e1d2969"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="f29e4ac4-0271-4b6e-ba1a-68f03a3a8b2d" name="ListMouseMotionHandler" visibility="protected">
                  <ownedComment xmi:id="9ebca160-cdb3-4063-adaa-9a79013bc032" body="This listener changes the selected item as you move the mouse over the list.&#xA;The selection change is not committed to the model, this is for user feedback only.&#xA;" annotatedElement="f29e4ac4-0271-4b6e-ba1a-68f03a3a8b2d"/>
                  <generalization xmi:id="b9baa5ad-5d10-49f8-a3d6-360e86ae5b28" isSubstitutable="true" general="ec5cea15-e58f-49f8-82b4-bd8d991ba03f"/>
                </nestedClassifier>
