                <interfaceRealization xmi:id="8efb7083-cacf-4dfd-b3b4-7e1e425cecf7" name="" supplier="9cddb005-9b1a-4ddf-896c-757b2ebcb34b" client="b78ad489-3223-4a6f-bad9-156354b33fc5" contract="9cddb005-9b1a-4ddf-896c-757b2ebcb34b"/>
