              <nestedClassifier xmi:type="uml:Class" xmi:id="10dd4282-c2ed-4726-8167-49b250f14078" name="DelayedWorkQueue" visibility="private" clientDependency="7a3b6ca2-5d5f-4be3-a5f0-3556aeee3259">
                <ownedComment xmi:id="40986fdc-df9c-4c59-98da-c23ed825ab2e" body="An annoying wrapper class to convince generics compiler to&#xA;use a DelayQueue&lt;ScheduledFutureTask> as a BlockingQueue&lt;Runnable>&#xA;" annotatedElement="10dd4282-c2ed-4726-8167-49b250f14078"/>
