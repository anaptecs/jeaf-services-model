              <packagedElement xmi:type="uml:Class" xmi:id="d9a8338e-59e2-46c9-a823-cf9a70b1eda5" name="SynthPasswordFieldUI" visibility="package">
                <ownedComment xmi:id="a966a630-a9f4-4713-849d-4a744962dd3d" body="Provides the Synth look and feel for a password field.&#xA;The only difference from the standard text field is that&#xA;the view of the text is simply a string of the echo&#xA;character as specified in JPasswordField, rather than the&#xA;real text contained in the field.&#xA;&#xA;@author  Shannon Hickey&#xA;@version 1.7 03/19/04&#xA;" annotatedElement="d9a8338e-59e2-46c9-a823-cf9a70b1eda5"/>
