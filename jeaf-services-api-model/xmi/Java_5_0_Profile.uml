              <interfaceRealization xmi:id="41df0c23-44ba-4464-9cf1-596a774de032" name="" supplier="312ed074-49fe-469c-a35f-8819c3088e38" client="442d0563-63e9-4034-aede-183002ed912b" contract="312ed074-49fe-469c-a35f-8819c3088e38"/>
