            <nestedClassifier xmi:type="uml:Class" xmi:id="67b98fc7-a96b-4697-9f38-c715ded9b243" name="ScaleSpring" visibility="private">
              <generalization xmi:id="e84ab142-4d53-4b7c-9be1-a5cd14b9ff82" isSubstitutable="true" general="17c485d8-5f7f-4635-b30a-14f498937ee0"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="7965fc87-4c25-4edd-a24e-69fa7f0b4dd2" name="WidthSpring" visibility="package">
              <generalization xmi:id="9be668f6-ca69-444e-873f-19f06f2666a2" isSubstitutable="true" general="9e5ba871-e70a-4c85-8351-987b9a4d8867"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="b5411264-41f8-4ac7-b067-5f871ea960e9" name="HeightSpring" visibility="package">
              <generalization xmi:id="1332b6e1-eb7b-4144-a74a-787b1d90ed3a" isSubstitutable="true" general="9e5ba871-e70a-4c85-8351-987b9a4d8867"/>
