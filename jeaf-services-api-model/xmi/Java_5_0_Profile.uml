              <packagedElement xmi:type="uml:Class" xmi:id="ed3607be-d0b9-4256-b9d5-2c566a623543" name="DefaultMenuLayout" visibility="package" clientDependency="272b6a68-3b37-42bf-b912-830f6e440530">
                <ownedComment xmi:id="506d379f-17f0-4697-846f-f38c0d0eadcc" body="The default layout manager for Popup menus and menubars.  This&#xA;class is an extension of BoxLayout which adds the UIResource tag&#xA;so that plauggable L&amp;Fs can distinguish it from user-installed&#xA;layout managers on menus.&#xA;&#xA;Derived from javax.swing.plaf.basic.DefaultMenuLayout&#xA;&#xA;@version 1.7 12/19/03&#xA;@author Georges Saab&#xA;" annotatedElement="ed3607be-d0b9-4256-b9d5-2c566a623543"/>
