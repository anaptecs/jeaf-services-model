              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="6d8c60b4-d7c1-4aef-808d-eb255e3c3767" isSubstitutable="true" general="884116a5-095b-44ee-8776-27b791384a79"/>
            <interfaceRealization xmi:id="97a9174d-ad50-4ed4-82eb-1c52a50f9c16" name="" supplier="e37e6b04-31ab-40e4-928f-e90e7db8a28e" client="dbe07c75-2235-4218-9ddb-b7005da3a941" contract="e37e6b04-31ab-40e4-928f-e90e7db8a28e"/>
            <interfaceRealization xmi:id="8b615eac-479d-4440-98f4-07b0e0869a1e" name="" supplier="312ed074-49fe-469c-a35f-8819c3088e38" client="dbe07c75-2235-4218-9ddb-b7005da3a941" contract="312ed074-49fe-469c-a35f-8819c3088e38"/>
