          <packagedElement xmi:type="uml:Class" xmi:id="3d25ab71-b7c8-422b-87af-ba2d805cc123" name="LayoutComparator" visibility="package" clientDependency="43f890cd-a758-4067-8dc5-08e36ff635a0 0862b95b-06d4-41e4-b4b9-3df1a40f28ce" isLeaf="true">
            <ownedComment xmi:id="cd344fe3-511d-4593-9319-9feb011a87ba" body="Comparator which attempts to sort Components based on their size and&#xA;position. Code adapted from original javax.swing.DefaultFocusManager&#xA;implementation.&#xA;&#xA;@version 1.7, 02/05/04&#xA;@author David Mendenhall&#xA;" annotatedElement="3d25ab71-b7c8-422b-87af-ba2d805cc123"/>
            <interfaceRealization xmi:id="0862b95b-06d4-41e4-b4b9-3df1a40f28ce" name="" supplier="c8b22087-9912-4328-9828-601ae8e74df9" client="3d25ab71-b7c8-422b-87af-ba2d805cc123" contract="c8b22087-9912-4328-9828-601ae8e74df9"/>
            <interfaceRealization xmi:id="43f890cd-a758-4067-8dc5-08e36ff635a0" name="" supplier="f68aec46-50b5-48d7-b5b4-79aa18484c4c" client="3d25ab71-b7c8-422b-87af-ba2d805cc123" contract="f68aec46-50b5-48d7-b5b4-79aa18484c4c"/>
