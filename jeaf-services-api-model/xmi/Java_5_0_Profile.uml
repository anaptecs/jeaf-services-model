                <interfaceRealization xmi:id="8b59a0c2-807f-42d7-a4b7-19329feaceca" name="" supplier="a5f9d9db-2cd9-4080-a286-ab40798c84e9" client="cfaf69e7-76ce-433c-808a-37fe8aeb8282" contract="a5f9d9db-2cd9-4080-a286-ab40798c84e9"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="561d3e30-872f-458a-bc25-b9b5884d94ae" name="Actions" visibility="private">
                  <ownedComment xmi:id="a31ae00d-0faa-4be0-a7f7-f79a995c0221" body="Actions for Buttons. Two type of action are supported:&#xA;pressed: Moves the button to a pressed state&#xA;released: Disarms the button.&#xA;" annotatedElement="561d3e30-872f-458a-bc25-b9b5884d94ae"/>
