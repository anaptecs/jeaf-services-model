              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="476f7d09-0712-4538-b713-6e37ea8e908e" isSubstitutable="true" general="146f1fb1-ef17-489f-8601-2087f115b512"/>
            <interfaceRealization xmi:id="f850de11-5931-4a33-bef1-fca53723f96a" name="" supplier="e37e6b04-31ab-40e4-928f-e90e7db8a28e" client="040502ab-c2ae-470a-8491-c444e5e3ff8d" contract="e37e6b04-31ab-40e4-928f-e90e7db8a28e"/>
