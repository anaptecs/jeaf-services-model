                </ownedParameter>
              </ownedTemplateSignature>
              <interfaceRealization xmi:id="bf7e897d-7dc9-4b27-9f7b-99270ef9713a" name="" supplier="f68aec46-50b5-48d7-b5b4-79aa18484c4c" client="e5707754-18d3-4194-83ad-646b42ae2ec1" contract="f68aec46-50b5-48d7-b5b4-79aa18484c4c"/>
            </nestedClassifier>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="fbbad6d8-a609-482f-968f-103e8d9cb039" name="RegularEnumSet" visibility="package">
            <ownedComment xmi:id="ecaf7d33-5d4a-4e86-ab17-6e05667f053a" body="Private implementation class for EnumSet, for &quot;regular sized&quot; enum types&#xA;(i.e., those with 64 or fewer enum constants).&#xA;&#xA;@author Josh Bloch&#xA;@since 1.5&#xA;@serial exclude&#xA;" annotatedElement="fbbad6d8-a609-482f-968f-103e8d9cb039"/>
