              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="844bf063-e5b2-4c4d-af28-cbc9593aa3e3" name="" parameter="b2a16086-488e-4927-87b5-3463e3803ef9 6be1c553-72e3-4fb5-9fb0-700f9a27f872">
