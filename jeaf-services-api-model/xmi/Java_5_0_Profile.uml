              <interfaceRealization xmi:id="05efde3a-8be2-4cf1-9a45-90d842212e74" name="" supplier="7f32009c-a62e-493f-a5d1-e144ee255c7b" client="71f41a62-d63a-442b-905f-fdb29427fb50" contract="7f32009c-a62e-493f-a5d1-e144ee255c7b"/>
              <nestedClassifier xmi:type="uml:Class" xmi:id="f492f290-9146-442b-a3ef-9f1147720b7f" name="AccessibleAWTComponentHandler" visibility="protected" clientDependency="69d08dea-acea-4e93-87a0-ea423f810e0e">
                <ownedComment xmi:id="b5a0450d-f2fd-4bfa-a6ca-bad8b6e8fff3" body="Fire PropertyChange listener, if one is registered,&#xA;when shown/hidden..&#xA;" annotatedElement="f492f290-9146-442b-a3ef-9f1147720b7f"/>
