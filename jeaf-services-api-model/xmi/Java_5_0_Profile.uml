            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="20977f59-7ffe-4d94-a069-e8dd465d6f35" name="TabularDataSupport" clientDependency="09a97933-1362-4ad7-b4ce-f715053cb8c0 b3db9894-9d52-403e-91ff-96e414c0bcad 9f66aed7-052f-4bb7-bfc8-919ad9675749 82a17f55-5734-447b-a016-5b57eeb84770">
              <ownedComment xmi:id="be5b8031-f1ad-417c-9c81-1ff06c9959d3" body="The &lt;tt>TabularDataSupport&lt;/tt> class is the &lt;i>open data&lt;/i> class which implements the &lt;tt>TabularData&lt;/tt>&#xA;and the &lt;tt>Map&lt;/tt> interfaces, and which is internally based on a hash map data structure.&#xA;&#xA;@version     3.30  03/12/19&#xA;@author      Sun Microsystems, Inc.&#xA;&#xA;@since 1.5&#xA;@since.unbundled JMX 1.1&#xA;" annotatedElement="20977f59-7ffe-4d94-a069-e8dd465d6f35"/>
              <interfaceRealization xmi:id="82a17f55-5734-447b-a016-5b57eeb84770" name="" supplier="9fa1379f-199b-43ac-95d5-14b7459bf1f5" client="20977f59-7ffe-4d94-a069-e8dd465d6f35" contract="9fa1379f-199b-43ac-95d5-14b7459bf1f5"/>
