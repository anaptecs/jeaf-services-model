            <nestedClassifier xmi:type="uml:Class" xmi:id="64eedbc2-8ccc-49c9-b178-d998536f3239" name="EmptyEnumerator" visibility="private" clientDependency="b77268e6-5f3b-45d1-bf20-9fdb99a9f2de">
              <ownedComment xmi:id="d6e9a1d1-e5d4-44bc-b647-82675e7db975" body="A hashtable enumerator class for empty hash tables, specializes&#xA;the general Enumerator&#xA;" annotatedElement="64eedbc2-8ccc-49c9-b178-d998536f3239"/>
