          <packagedElement xmi:type="uml:Class" xmi:id="d8a41cd7-3f85-4cd4-a9bb-52a282ff6eda" name="javax_swing_JFrame_PersistenceDelegate" visibility="package">
            <generalization xmi:id="56a2b3e8-aeb6-4e28-a85a-ebd5a0ff4ddc" isSubstitutable="true" general="b376c4fb-0c0f-4886-a3a7-2b8e36c0aa70"/>
