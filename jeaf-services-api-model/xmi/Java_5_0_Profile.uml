                    <ownedParameteredElement xmi:type="uml:Class" xmi:id="65fcce43-a90b-4a6b-9291-ff0c1ba2bfd1" name="K" templateParameter="a62b69b2-df93-4382-8b8f-525fab63409e"/>
                  </ownedParameter>
