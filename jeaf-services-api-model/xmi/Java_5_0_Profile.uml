              <ownedComment xmi:id="7a229253-1427-4286-bfa2-7fefde88ca0f" body="A popup menu-specific separator.&#xA;" annotatedElement="9e122c05-0922-4b55-ac11-b36f198f52db"/>
              <generalization xmi:id="8777cd07-e723-4a9c-b8b0-6e52aec760db" isSubstitutable="true" general="4e876347-fdd1-41e7-9e7a-d061a27619d8"/>
