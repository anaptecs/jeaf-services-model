          <packagedElement xmi:type="uml:Class" xmi:id="4d0d4029-87db-4302-8032-50c04e6b61a5" name="XMLUtils" visibility="package">
            <ownedComment xmi:id="53903c26-f13e-46c3-b37e-5a0cb276ddc9" body="A class used to aid in Properties load and save in XML. Keeping this&#xA;code outside of Properties helps reduce the number of classes loaded&#xA;when Properties is loaded.&#xA;&#xA;@version 1.9, 01/23/03&#xA;@author  Michael McCloskey&#xA;@since   1.3&#xA;" annotatedElement="4d0d4029-87db-4302-8032-50c04e6b61a5"/>
            <nestedClassifier xmi:type="uml:Class" xmi:id="bdb57b95-5979-4615-89ac-a3c5bf29cb68" name="Resolver" visibility="private" clientDependency="f59cab39-6d0c-4064-95d7-147281874435">
