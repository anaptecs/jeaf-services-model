              <packagedElement xmi:type="uml:Class" xmi:id="acbdfe49-423d-4857-8e29-7cdcef8f2dbc" name="AtomicIntegerArray" clientDependency="e5f4f3cf-2127-477c-9142-4bb751bbe4de">
                <ownedComment xmi:id="e6c887f3-cb39-4f87-84ad-dcecdd9dfa33" body="An &lt;tt>int&lt;/tt> array in which elements may be updated atomically.&#xA;See the {@link java.util.concurrent.atomic} package&#xA;specification for description of the properties of atomic&#xA;variables.&#xA;@since 1.5&#xA;@author Doug Lea&#xA;" annotatedElement="acbdfe49-423d-4857-8e29-7cdcef8f2dbc"/>
