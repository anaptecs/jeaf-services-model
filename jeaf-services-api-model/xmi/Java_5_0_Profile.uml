              <interfaceRealization xmi:id="9dfa653f-5fb3-4dc9-a90f-a262050ae2a3" name="" supplier="a5f9d9db-2cd9-4080-a286-ab40798c84e9" client="2b34b99f-6deb-4979-b633-4cc8e4ec1cd2" contract="a5f9d9db-2cd9-4080-a286-ab40798c84e9"/>
              <interfaceRealization xmi:id="1dcfd915-ac4f-449b-b4c0-81edf62e2857" name="" supplier="8db3114b-211e-4a96-9f28-490b65735833" client="2b34b99f-6deb-4979-b633-4cc8e4ec1cd2" contract="8db3114b-211e-4a96-9f28-490b65735833"/>
              <nestedClassifier xmi:type="uml:Class" xmi:id="38d21456-043f-4726-87c2-2a313276aea2" name="BCSIterator" visibility="protected" clientDependency="b54de486-d5ea-4664-9839-f9aa221d9d0a" isLeaf="true">
                <ownedComment xmi:id="571560c4-d9fd-483b-96c4-936548522ee8" body="protected final subclass that encapsulates an iterator but implements&#xA;a noop remove() method.&#xA;" annotatedElement="38d21456-043f-4726-87c2-2a313276aea2"/>
