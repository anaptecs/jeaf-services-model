          <packagedElement xmi:type="uml:Class" xmi:id="0c55d7ae-f50e-4715-a6dd-2bb8d460cff3" name="MBeanFeatureInfo" clientDependency="56e6a728-8f8c-4f70-89cf-3488305c4f48">
            <ownedComment xmi:id="025c3dbf-000e-4042-9e86-f69cd8d59a77" body="&lt;p>Provides general information for an MBean descriptor object.&#xA;The feature described can be an attribute, an operation, a&#xA;parameter, or a notification.  Instances of this class are&#xA;immutable.  Subclasses may be mutable but this is not&#xA;recommended.&lt;/p>&#xA;&#xA;@since 1.5&#xA;" annotatedElement="0c55d7ae-f50e-4715-a6dd-2bb8d460cff3"/>
