          <packagedElement xmi:type="uml:Interface" xmi:id="bc3ef402-eaf8-4975-b33a-95fda5ec1b23" name="Iterator&lt;String>">
            <templateBinding xmi:id="9684d50e-70b4-4c3b-af5a-33bc95b7d4da" signature="f07b665e-9514-4136-b027-012857dc009f">
              <parameterSubstitution xmi:id="897543ae-8b4b-4ae6-a074-275d3ea8cf69" formal="fd6cd0cf-39ee-4bed-8a06-d2bde265669f" actual="a4eb9ea3-845f-4203-b10c-3bbf5f7cd147"/>
