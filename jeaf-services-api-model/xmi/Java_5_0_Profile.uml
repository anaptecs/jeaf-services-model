          <packagedElement xmi:type="uml:Class" xmi:id="3bd11e4c-0736-4625-b1c3-28772193dd7a" name="EnumMapIterator&lt;V>">
            <templateBinding xmi:id="6dc936b5-bd96-4663-9a62-901f2f1e5c1a" signature="379e82ff-3577-4750-afd9-da3677fa49ca">
              <parameterSubstitution xmi:id="b9b43a35-a949-43c7-ac0e-4f97f1b820a8" formal="6e4ff5db-3412-4963-8960-21326abec0d4" actual="233d9d9a-d6f6-4b75-be97-2f83a1c357ce"/>
