              <packagedElement xmi:type="uml:Interface" xmi:id="84ff732b-1579-4698-b98d-ce0ad9a1581a" name="SynthConstants" isAbstract="true">
                <ownedComment xmi:id="23887947-c1e6-414f-845b-b119640159cf" body="Constants used by Synth. Not all Components support all states. A&#xA;Component will at least be in one of the primary states. That is, the&#xA;return value from &lt;code>SynthContext.getComponentState()&lt;/code> will at&#xA;least be one of &lt;code>ENABLED&lt;/code>, &lt;code>MOUSE_OVER&lt;/code>,&#xA;&lt;code>PRESSED&lt;/code> or &lt;code>DISABLED&lt;/code>, and may also contain&#xA;&lt;code>FOCUSED&lt;/code>, &lt;code>SELECTED&lt;/code> or &lt;code>DEFAULT&lt;/code>.&#xA;&#xA;@version 1.7, 12/19/03&#xA;@since 1.5&#xA;" annotatedElement="84ff732b-1579-4698-b98d-ce0ad9a1581a"/>
              </packagedElement>
