              <generalization xmi:id="f9e675c9-8c97-42ae-8e6f-97df8a66c350" isSubstitutable="true" general="70a44d7b-e856-4ab7-8ee7-7a072643e865"/>
              <interfaceRealization xmi:id="b234a759-0d69-4936-8682-d742f9c0666f" name="" supplier="cfdf75c9-f6d2-4c45-9d0a-3056d9bc9908" client="a5c3cb1d-be6a-4dd3-a50f-2c54cdda44a0" contract="cfdf75c9-f6d2-4c45-9d0a-3056d9bc9908"/>
              <interfaceRealization xmi:id="65cc77ce-172b-45e8-a53e-2a1a29fa6eb1" name="" supplier="f68aec46-50b5-48d7-b5b4-79aa18484c4c" client="a5c3cb1d-be6a-4dd3-a50f-2c54cdda44a0" contract="f68aec46-50b5-48d7-b5b4-79aa18484c4c"/>
              <nestedClassifier xmi:type="uml:Class" xmi:id="34954d74-b2fa-41e7-85fb-daf612753a7a" name="HashEntry" visibility="package" isLeaf="true">
                <ownedComment xmi:id="c3b0ca53-eaaf-4fdc-b7f4-c31e7e4d1d80" body="ConcurrentHashMap list entry. Note that this is never exported&#xA;out as a user-visible Map.Entry.&#xA;&#xA;Because the value field is volatile, not final, it is legal wrt&#xA;the Java Memory Model for an unsynchronized reader to see null&#xA;instead of initial value when read via a data race.  Although a&#xA;reordering leading to this is not likely to ever actually&#xA;occur, the Segment.readValueUnderLock method is used as a&#xA;backup in case a null (pre-initialized) value is ever seen in&#xA;an unsynchronized access method.&#xA;" annotatedElement="34954d74-b2fa-41e7-85fb-daf612753a7a"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="82f801ff-442b-4077-8c44-6300a7a32faa" name="" parameter="a62b69b2-df93-4382-8b8f-525fab63409e 46e6b1f9-acef-4abc-a89b-4713fa579d80">
