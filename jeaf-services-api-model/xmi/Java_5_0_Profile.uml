                <ownedComment xmi:id="3cfa131a-48bf-41f7-afc6-5ffba32e3c1f" body="Default drag gesture recognition for drag operations performed by classses&#xA;that have a &lt;code>dragEnabled&lt;/code> property.  The gesture for a drag in&#xA;this package is a mouse press over a selection followed by some movement&#xA;by enough pixels to keep it from being treated as a click.&#xA;&#xA;@author  Timothy Prinzing&#xA;@version 1.7 12/19/03&#xA;" annotatedElement="551d7548-ac98-48c2-9a5f-1e31d7ae31dd"/>
                <interfaceRealization xmi:id="e13fce69-748c-4562-85c6-977b9205f113" name="" supplier="961072eb-6a4e-4b3d-8680-edd453ed48c8" client="551d7548-ac98-48c2-9a5f-1e31d7ae31dd" contract="961072eb-6a4e-4b3d-8680-edd453ed48c8"/>
