          <packagedElement xmi:type="uml:Interface" xmi:id="4c75c124-5015-4361-b865-4a1084211f4a" name="Deprecated" isAbstract="true">
            <ownedComment xmi:id="0e80a345-cdad-4467-8682-ceb691c948f8" body="A program element annotated &amp;#64;Deprecated is one that programmers&#xA;are discouraged from using, typically because it is dangerous,&#xA;or because a better alternative exists.  Compilers warn when a&#xA;deprecated program element is used or overridden in non-deprecated code.&#xA;&#xA;@author  Neal Gafter&#xA;@version 1.4, 06/10/04&#xA;@since 1.5&#xA;" annotatedElement="4c75c124-5015-4361-b865-4a1084211f4a"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="79a99800-4e99-48a4-8b31-9df3e2c3259d" name="AbstractSet&lt;Entry&lt;String, String>>">
