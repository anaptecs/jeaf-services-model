            <packagedElement xmi:type="uml:Interface" xmi:id="acfcd247-b241-4ca3-87de-4900827f76a6" name="PreferenceChangeListener" isAbstract="true">
              <ownedComment xmi:id="922481d6-4da5-41ad-b796-06adcbfa5708" body="A listener for receiving preference change events.&#xA;&#xA;@author  Josh Bloch&#xA;@version 1.4, 12/19/03&#xA;@see Preferences&#xA;@see PreferenceChangeEvent&#xA;@see NodeChangeListener&#xA;@since   1.4&#xA;" annotatedElement="acfcd247-b241-4ca3-87de-4900827f76a6"/>
