              <nestedClassifier xmi:type="uml:Class" xmi:id="9b36ecbe-ce41-4656-bb70-2b3c84cae773" name="SynchronizedPrintServiceAttributeSet" visibility="private" clientDependency="3d54c0fb-c5e7-4914-9e42-08792a5e0388 eedfce8e-f2fc-4b2a-9bde-5d13f13880e3">
                <ownedComment xmi:id="152fbd8c-7aba-49d7-8c5c-35115bdbccdc" body="@serial include&#xA;" annotatedElement="9b36ecbe-ce41-4656-bb70-2b3c84cae773"/>
                <generalization xmi:id="c16d906b-bdf0-4a74-9827-3216ac3cc848" isSubstitutable="true" general="ae4260ca-4248-4268-b7a8-8a17aa36c97c"/>
                <interfaceRealization xmi:id="3d54c0fb-c5e7-4914-9e42-08792a5e0388" name="" supplier="ad26ae5d-9b71-49a8-bbe2-a13e54df1081" client="9b36ecbe-ce41-4656-bb70-2b3c84cae773" contract="ad26ae5d-9b71-49a8-bbe2-a13e54df1081"/>
