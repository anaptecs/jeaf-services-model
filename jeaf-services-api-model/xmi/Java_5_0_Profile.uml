            <packagedElement xmi:type="uml:Package" xmi:id="63f52a45-bbd9-4b4d-81e3-75b2590e89e9" name="atomic">
              <packagedElement xmi:type="uml:Class" xmi:id="457c30e1-1f9c-428c-b799-253097902fde" name="AtomicIntegerFieldUpdater" isAbstract="true">
                <ownedComment xmi:id="6115de6b-3421-4125-a897-5f31c3a72c58" body="A reflection-based utility that enables atomic updates to&#xA;designated &lt;tt>volatile int&lt;/tt> fields of designated classes.&#xA;This class is designed for use in atomic data structures in which&#xA;several fields of the same node are independently subject to atomic&#xA;updates.&#xA;&#xA;&lt;p> Note that the guarantees of the &lt;tt>compareAndSet&lt;/tt> method&#xA;in this class are weaker than in other atomic classes. Because this&#xA;class cannot ensure that all uses of the field are appropriate for&#xA;purposes of atomic access, it can guarantee atomicity and volatile&#xA;semantics only with respect to other invocations of&#xA;&lt;tt>compareAndSet&lt;/tt> and &lt;tt>set&lt;/tt>.&#xA;@since 1.5&#xA;@author Doug Lea&#xA;@param &lt;T> The type of the object holding the updatable field&#xA;" annotatedElement="457c30e1-1f9c-428c-b799-253097902fde"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="c6b103fc-3e72-46b3-bf4c-cd731b8a4a45" name="" parameter="1bba68d0-214c-4dc4-afdc-7e6affa1527c">
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="1bba68d0-214c-4dc4-afdc-7e6affa1527c" parameteredElement="51bcca96-be75-4b2e-b105-7ede1c382d9e">
                    <ownedParameteredElement xmi:type="uml:Class" xmi:id="51bcca96-be75-4b2e-b105-7ede1c382d9e" name="T" templateParameter="1bba68d0-214c-4dc4-afdc-7e6affa1527c"/>
                  </ownedParameter>
                </ownedTemplateSignature>
                <nestedClassifier xmi:type="uml:Class" xmi:id="ca43904b-5a99-4bf1-ab9d-3532ecef87f2" name="AtomicIntegerFieldUpdaterImpl" visibility="private">
                  <ownedComment xmi:id="e42b4dbc-6432-4349-833b-20994c3db58b" body="Standard hotspot implementation using intrinsics&#xA;" annotatedElement="ca43904b-5a99-4bf1-ab9d-3532ecef87f2"/>
                  <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="cf625edf-5f25-4fb3-96c9-1320931f77a1" name="" parameter="df1d89dc-3598-4d17-994c-6191276d0b85">
                    <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="df1d89dc-3598-4d17-994c-6191276d0b85" parameteredElement="71fad112-566e-4ac5-806a-bb18a5c83f53">
