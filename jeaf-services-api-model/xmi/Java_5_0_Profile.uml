            <packagedElement xmi:type="uml:Class" xmi:id="3142251f-a29c-4784-940c-ff93892cb029" name="OpenMBeanInfoSupport" clientDependency="ba03198d-f00d-4e4d-954e-8ee4f4bff245 d8b73225-cd58-44a8-9d19-0a2cae45eacb">
              <ownedComment xmi:id="c717e3d2-a261-4b52-ab6e-879c9d746933" body="The &lt;tt>OpenMBeanInfoSupport&lt;/tt> class describes the management information of an &lt;i>open MBean&lt;/i>:&#xA;it is a subclass of {@link javax.management.MBeanInfo}, and it implements the {@link OpenMBeanInfo} interface.&#xA;Note that an &lt;i>open MBean&lt;/i> is recognized as such if its &lt;tt>getMBeanInfo()&lt;/tt> method returns an instance of a class&#xA;which implements the OpenMBeanInfo interface, typically &lt;tt>OpenMBeanInfoSupport&lt;/tt>.&#xA;&#xA;@version     3.22  03/12/19&#xA;@author      Sun Microsystems, Inc.&#xA;&#xA;@since 1.5&#xA;@since.unbundled JMX 1.1&#xA;" annotatedElement="3142251f-a29c-4784-940c-ff93892cb029"/>
              <generalization xmi:id="060715f6-e9e9-4227-ad3d-40f99b71de3e" isSubstitutable="true" general="073f3607-f137-47c1-baad-b140fcdc336c"/>
              <interfaceRealization xmi:id="ba03198d-f00d-4e4d-954e-8ee4f4bff245" name="" supplier="2824b38b-a6e4-4f06-a3ff-90ffc03302e0" client="3142251f-a29c-4784-940c-ff93892cb029" contract="2824b38b-a6e4-4f06-a3ff-90ffc03302e0"/>
