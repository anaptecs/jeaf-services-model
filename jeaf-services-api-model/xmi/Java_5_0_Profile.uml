          <packagedElement xmi:type="uml:Class" xmi:id="44f5268b-8dc3-4d1a-a7e5-c49afa42d8da" name="TimerThread" visibility="package">
            <ownedComment xmi:id="3ac48164-3468-4f84-a90e-3755da1d35f2" body="This &quot;helper class&quot; implements the timer's task execution thread, which&#xA;waits for tasks on the timer queue, executions them when they fire,&#xA;reschedules repeating tasks, and removes cancelled tasks and spent&#xA;non-repeating tasks from the queue.&#xA;" annotatedElement="44f5268b-8dc3-4d1a-a7e5-c49afa42d8da"/>
            <generalization xmi:id="55819e4a-9b7c-47b0-bd9e-4617e373932f" isSubstitutable="true" general="a30ec99e-bb56-4200-8405-bb8e069bb0c4"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Interface" xmi:id="fa262b92-77da-45e5-92a6-677f15c03a98" name="Iterator&lt;T>">
