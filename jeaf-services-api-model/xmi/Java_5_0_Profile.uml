                <ownedComment xmi:id="0cdd0be1-2d5e-4d42-a7ec-491b8ebadbf9" body="Case independent ASCII value.&#xA;" annotatedElement="3219a52b-63c4-43c2-9e28-dcf770a18576"/>
                <generalization xmi:id="cc88a7d5-d5df-45f4-bed1-924a6f990c30" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="187863e8-9e1f-4c74-8a6b-af3ab48179f2" name="NotSingleA" visibility="package" isLeaf="true">
                <generalization xmi:id="74b6629c-f8bb-4438-9006-487ce2fbd534" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
