                <nestedClassifier xmi:type="uml:Class" xmi:id="fbe105f9-f24b-49b3-a838-6f482f6787e4" name="ReadLock" clientDependency="1983343b-a4ed-48c2-b640-14cdff092410 855d3137-0384-4a94-a7b9-b4bdb70c921b">
                  <ownedComment xmi:id="534a7e0f-d78e-457c-98bc-786568b71866" body="The lock returned by method {@link ReentrantReadWriteLock#readLock}.&#xA;" annotatedElement="fbe105f9-f24b-49b3-a838-6f482f6787e4"/>
                  <interfaceRealization xmi:id="855d3137-0384-4a94-a7b9-b4bdb70c921b" name="" supplier="a596440a-85e0-4f09-a6d5-2059577833d8" client="fbe105f9-f24b-49b3-a838-6f482f6787e4" contract="a596440a-85e0-4f09-a6d5-2059577833d8"/>
                  <interfaceRealization xmi:id="1983343b-a4ed-48c2-b640-14cdff092410" name="" supplier="f68aec46-50b5-48d7-b5b4-79aa18484c4c" client="fbe105f9-f24b-49b3-a838-6f482f6787e4" contract="f68aec46-50b5-48d7-b5b4-79aa18484c4c"/>
