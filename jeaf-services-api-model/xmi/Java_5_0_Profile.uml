                  <ownedComment xmi:id="bc3b32f8-45f9-4c6e-9567-714410eedfc3" body="A field view that support bidirectional text via the&#xA;support provided by ParagraphView.&#xA;" annotatedElement="2c6333a7-5b00-4c63-926d-80cf8b495960"/>
                  <generalization xmi:id="7ec1a72b-fb73-47bc-b65b-1d2ee86503b8" isSubstitutable="true" general="c38d2aa7-987e-4f63-be64-82fbf90fff6f"/>
                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="fc9a93a3-6dd6-4017-8722-55389022b679" name="BasicPasswordFieldUI">
                <ownedComment xmi:id="d51de03c-c7ac-4b4d-a357-3a183ec59db1" body="Provides the Windows look and feel for a password field.&#xA;The only difference from the standard text field is that&#xA;the view of the text is simply a string of the echo&#xA;character as specified in JPasswordField, rather than the&#xA;real text contained in the field.&#xA;&#xA;@author  Timothy Prinzing&#xA;@version 1.30 12/19/03&#xA;" annotatedElement="fc9a93a3-6dd6-4017-8722-55389022b679"/>
