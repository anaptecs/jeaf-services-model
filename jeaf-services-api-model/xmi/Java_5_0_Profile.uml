                  <ownedComment xmi:id="6fe17e81-c0bd-429f-9f30-45e65888783f" body="This listener watches for changes to the selection in the&#xA;combo box.&#xA;" annotatedElement="d8c6e0aa-db58-4350-b497-9c0a9f083a8b"/>
                  <interfaceRealization xmi:id="a395ec0a-bafb-40aa-ac89-1f218f6b3a8b" name="" supplier="85ac562c-0f1a-4479-8d73-62e24c64a57b" client="d8c6e0aa-db58-4350-b497-9c0a9f083a8b" contract="85ac562c-0f1a-4479-8d73-62e24c64a57b"/>
