              <nestedClassifier xmi:type="uml:Class" xmi:id="979a687d-8429-4401-a036-b0cdca621524" name="DefaultTransferHandler" visibility="package" clientDependency="a08fed2e-1036-41f4-912a-e7ec8c773986">
                <ownedComment xmi:id="0cbc67ee-31f5-4215-a284-d492d3f98f7d" body="A Simple TransferHandler that exports the data as a String, and&#xA;imports the data from the String clipboard.  This is only used&#xA;if the UI hasn't supplied one, which would only happen if someone&#xA;hasn't subclassed Basic.&#xA;" annotatedElement="979a687d-8429-4401-a036-b0cdca621524"/>
                <generalization xmi:id="dc27ff18-b061-42e2-b6d5-69d561cc50d5" isSubstitutable="true" general="2076c3aa-0944-472c-992c-315810f82869"/>
