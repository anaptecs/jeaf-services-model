          <packagedElement xmi:type="uml:Interface" xmi:id="e3494e83-a3eb-449d-a649-644bdb527876" name="Comparable&lt;SelfComparable>">
            <templateBinding xmi:id="3b7eb1dc-4555-4f92-aea2-b914e206e9ad" signature="090eff04-654e-4939-a618-5fadf2a459dc">
