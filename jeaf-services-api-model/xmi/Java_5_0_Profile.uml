              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="3808f6a8-06aa-40d2-a884-a6ca1bb57f1b" isSubstitutable="true" general="f10bc939-783f-4901-bd7a-a9a2972cf00d"/>
            <interfaceRealization xmi:id="513fb672-bbd4-409e-927b-4bd8cfecb4cc" name="" supplier="e37e6b04-31ab-40e4-928f-e90e7db8a28e" client="9a65b9c9-43dd-49b9-ad02-00ad65392eba" contract="e37e6b04-31ab-40e4-928f-e90e7db8a28e"/>
            <nestedClassifier xmi:type="uml:Class" xmi:id="492eddd4-d03d-4a6c-a592-e4310acb495e" name="Itr" visibility="private" clientDependency="7c925265-d67d-45ed-8156-f7052d664af2">
              <interfaceRealization xmi:id="7c925265-d67d-45ed-8156-f7052d664af2" name="" supplier="3953ddc7-5664-488f-b915-a11d5ac3406d" client="492eddd4-d03d-4a6c-a592-e4310acb495e" contract="3953ddc7-5664-488f-b915-a11d5ac3406d"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="218e9b99-d993-431c-b2ed-1049d5d4136d" name="ListItr" visibility="private" clientDependency="4731c0d0-e470-4581-ad07-8a93a9b3ec24">
              <generalization xmi:id="2c26005d-7632-4cd2-999c-e45c29fe9b58" isSubstitutable="true" general="492eddd4-d03d-4a6c-a592-e4310acb495e"/>
              <interfaceRealization xmi:id="4731c0d0-e470-4581-ad07-8a93a9b3ec24" name="" supplier="e3d6d583-1516-4b70-af37-d688a4e7c617" client="218e9b99-d993-431c-b2ed-1049d5d4136d" contract="e3d6d583-1516-4b70-af37-d688a4e7c617"/>
