          <packagedElement xmi:type="uml:Class" xmi:id="9d2b1f1b-231e-4d35-8c5a-c446512a3a66" name="BufferUnderflowException">
            <ownedComment xmi:id="67f84825-3137-4a7c-bd38-6758a06c990e" body="Unchecked exception thrown when a relative &lt;i>get&lt;/i> operation reaches&#xA;the source buffer's limit.&#xA;&#xA;@version 1.14, 01/05/02&#xA;@since 1.4&#xA;" annotatedElement="9d2b1f1b-231e-4d35-8c5a-c446512a3a66"/>
