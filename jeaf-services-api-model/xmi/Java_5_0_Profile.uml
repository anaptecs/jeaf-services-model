                <ownedComment xmi:id="0994d266-f33b-4d11-abf2-ecc345b6d540" body="A default L&amp;F implementation of MenuUI.  This implementation&#xA;is a &quot;combined&quot; view/controller.&#xA;&#xA;@version 1.158 02/26/04&#xA;@author Georges Saab&#xA;@author David Karlton&#xA;@author Arnaud Weber&#xA;" annotatedElement="a9a3c6ea-427f-4a58-b16b-8fe489ef78b6"/>
