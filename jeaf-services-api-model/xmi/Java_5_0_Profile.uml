            <packagedElement xmi:type="uml:Class" xmi:id="da6f1839-0f2e-4be0-9306-c2e2653ce3f2" name="GeneralPathIterator" visibility="package" clientDependency="bb66d6b8-4de9-4575-b52c-0ed49cd60c28">
              <ownedComment xmi:id="137b2c5d-7fee-4ee6-8a96-f48f2d94a4f6" body="This class represents the iterator for General Paths.&#xA;It can be used to retrieve all of the elements in a GeneralPath.&#xA;The {@link GeneralPath#getPathIterator}&#xA;method is used to create a&#xA;GeneralPathIterator for a particular GeneralPath.&#xA;The iterator can be used to iterator the path only once.&#xA;Subsequent iterations require a new iterator.&#xA;&#xA;@see GeneralPath&#xA;&#xA;@version 10 Feb 1997&#xA;@author&#x9;Jim Graham&#xA;" annotatedElement="da6f1839-0f2e-4be0-9306-c2e2653ce3f2"/>
