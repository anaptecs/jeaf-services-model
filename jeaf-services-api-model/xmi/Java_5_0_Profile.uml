          <packagedElement xmi:type="uml:Class" xmi:id="7e312c00-1578-455b-b16e-1c78770eebd0" name="ProcessImpl" visibility="package" isLeaf="true">
            <generalization xmi:id="dce06263-081c-441a-90e0-629e55cff66e" isSubstitutable="true" general="b9401810-22ef-4f2f-b75d-803a172a1501"/>
