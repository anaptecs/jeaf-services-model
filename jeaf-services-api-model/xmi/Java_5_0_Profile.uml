              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="e3005348-ed3a-4da7-aab8-e30ed58c0d24" isSubstitutable="true" general="983e131a-6345-4312-bf40-4b1e79c18b6e"/>
            <interfaceRealization xmi:id="696b88ed-641f-4d46-b45f-ec86949f97a1" name="" supplier="98af2a4f-be42-4a2f-9feb-d546cf8cfdb1" client="a435e1cd-e9dd-4817-909c-7db0a3767b6a" contract="98af2a4f-be42-4a2f-9feb-d546cf8cfdb1"/>
            <interfaceRealization xmi:id="b9d2656f-0198-45c9-97b6-61ed96086b86" name="" supplier="798c1f41-63e5-47dc-9090-3495dac86a21" client="a435e1cd-e9dd-4817-909c-7db0a3767b6a" contract="798c1f41-63e5-47dc-9090-3495dac86a21"/>
            <interfaceRealization xmi:id="69249962-c36c-43d0-8e68-2c087ebd12b8" name="" supplier="f68aec46-50b5-48d7-b5b4-79aa18484c4c" client="a435e1cd-e9dd-4817-909c-7db0a3767b6a" contract="f68aec46-50b5-48d7-b5b4-79aa18484c4c"/>
