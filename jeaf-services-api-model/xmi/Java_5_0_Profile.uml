              <interfaceRealization xmi:id="c00c0180-2634-47c1-b787-ca38d6b8b6c1" name="" supplier="7fa702a1-b36f-46ce-84db-f895a45577ee" client="9ae2af9e-e8ba-45c7-8e03-8a7b123c2060" contract="7fa702a1-b36f-46ce-84db-f895a45577ee"/>
