            <nestedClassifier xmi:type="uml:Class" xmi:id="3fe15e16-ed44-4678-9d89-ca3c190fa30a" name="EntryIterator" visibility="private" clientDependency="76fefe41-edcb-4369-a10a-418dd0f5ded4">
              <ownedComment xmi:id="1479735d-387e-46b8-a5f4-8cfe6c251cb8" body="Since we don't use Entry objects, we use the Iterator itself as entry.&#xA;" annotatedElement="3fe15e16-ed44-4678-9d89-ca3c190fa30a"/>
