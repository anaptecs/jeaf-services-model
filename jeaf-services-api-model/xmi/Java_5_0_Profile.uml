          <packagedElement xmi:type="uml:Class" xmi:id="b5e7373e-5775-4bf2-ae90-9f075f9e1475" name="AbstractStringBuilder" visibility="package" clientDependency="10236173-ae23-45ac-9210-985a0e638865 0a16ce57-a153-441a-b784-28762df1b5cc" isAbstract="true">
            <ownedComment xmi:id="f17df6ec-90ad-4608-a268-01505dacd6a5" body="A mutable sequence of characters.&#xA;&lt;p>&#xA;Implements a modifiable string. At any point in time it contains some&#xA;particular sequence of characters, but the length and content of the&#xA;sequence can be changed through certain method calls.&#xA;&#xA;@author&#x9;Michael McCloskey&#xA;@version &#x9;1.12, 07/16/04&#xA;@since&#x9;1.5&#xA;" annotatedElement="b5e7373e-5775-4bf2-ae90-9f075f9e1475"/>
            <interfaceRealization xmi:id="0a16ce57-a153-441a-b784-28762df1b5cc" name="" supplier="665f3a31-6a1c-4b95-9abd-06797b439f19" client="b5e7373e-5775-4bf2-ae90-9f075f9e1475" contract="665f3a31-6a1c-4b95-9abd-06797b439f19"/>
