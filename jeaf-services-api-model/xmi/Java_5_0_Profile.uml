          <packagedElement xmi:type="uml:Class" xmi:id="96d18812-112a-4ac7-a48f-f14495490a29" name="javax_swing_Box_PersistenceDelegate" visibility="package">
            <generalization xmi:id="209350db-c930-43dd-96fe-1ce05b96656a" isSubstitutable="true" general="b376c4fb-0c0f-4886-a3a7-2b8e36c0aa70"/>
