            <packagedElement xmi:type="uml:Class" xmi:id="bae40182-90a1-4508-b74d-069ee978a67e" name="DefaultRGBChooserPanel" visibility="package" clientDependency="da439418-f352-4e93-8672-0b5124891f7c">
