              <nestedClassifier xmi:type="uml:Class" xmi:id="0fc35493-c4f6-4815-a9b7-1250c79e7fc2" name="StyleChangeHandler" visibility="package" clientDependency="ab006c79-807e-4a4a-9997-58657be358c4">
                <ownedComment xmi:id="a87df5a1-0deb-4e29-8a51-bb054e8bc9c9" body="Added to all the Styles. When instances of this receive a&#xA;stateChanged method, styleChanged is invoked.&#xA;" annotatedElement="0fc35493-c4f6-4815-a9b7-1250c79e7fc2"/>
