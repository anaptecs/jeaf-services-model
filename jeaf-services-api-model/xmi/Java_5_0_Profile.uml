              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="c98562f6-a9d9-418c-98de-70542e9daf85" name="StyleContextChangeHandler" visibility="package" clientDependency="37a19bff-675d-48b3-bbbf-1a40a35e5428">
                <ownedComment xmi:id="e552f973-82fe-4744-9653-e6d3cb8dde05" body="Added to the StyleContext. When the StyleContext changes, this invokes&#xA;&lt;code>updateStylesListeningTo&lt;/code>.&#xA;" annotatedElement="c98562f6-a9d9-418c-98de-70542e9daf85"/>
