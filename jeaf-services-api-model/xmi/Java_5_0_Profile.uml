              <packagedElement xmi:type="uml:Class" xmi:id="c00f439f-cf76-4807-a44a-9f6ef0071b75" name="CachedPainter" visibility="package" isAbstract="true">
                <ownedComment xmi:id="c7a6c013-6faa-4d30-b0d6-0da4acfa45f6" body="A base class used for icons or images that are expensive to paint.&#xA;A subclass will do the following:&#xA;&lt;ol>&#xA;&lt;li>Invoke &lt;code>paint&lt;/code> when you want to paint the image,&#xA;if you are implementing &lt;code>Icon&lt;/code> you'll invoke this from&#xA;&lt;code>paintIcon&lt;/code>.&#xA;The args argument is useful when additional state is needed.&#xA;&lt;li>Override &lt;code>paintToImage&lt;/code> to render the image.  The code that&#xA;lives here is equivalent to what previously would go in&#xA;&lt;code>paintIcon&lt;/code>, for an &lt;code>Icon&lt;/code>.&#xA;&lt;/ol>&#xA;&#xA;@version @(#)CachedPainter.java&#x9;1.2 04/02/15&#xA;" annotatedElement="c00f439f-cf76-4807-a44a-9f6ef0071b75"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="ca4be211-1c0d-4428-9811-b30f67fc5640" name="Cache" visibility="private">
                  <ownedComment xmi:id="06d72de7-dbad-43da-be48-136453c1bd33" body="Cache is used to cache an image based on a set of arguments.&#xA;" annotatedElement="ca4be211-1c0d-4428-9811-b30f67fc5640"/>
                  <nestedClassifier xmi:type="uml:Class" xmi:id="3b408926-9883-43cd-9d38-ae9caec0698e" name="Entry" visibility="private">
                    <ownedComment xmi:id="d662853d-6eea-4e7b-ac30-6924782c4250" body="Caches set of arguments and Image.&#xA;" annotatedElement="3b408926-9883-43cd-9d38-ae9caec0698e"/>
                  </nestedClassifier>
                </nestedClassifier>
              </packagedElement>
