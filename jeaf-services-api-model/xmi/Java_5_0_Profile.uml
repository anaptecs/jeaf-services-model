            <generalization xmi:id="7d4a178c-1a52-4448-abdd-43961780cf41" isSubstitutable="true" general="884116a5-095b-44ee-8776-27b791384a79"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="b9c3bc46-a8c8-4d73-a59d-29279eb04dc5" name="Arrays">
            <ownedComment xmi:id="8ca49cb5-a8c6-4852-b008-b636fd50b26d" body="This class contains various methods for manipulating arrays (such as&#xA;sorting and searching).  This class also contains a static factory&#xA;that allows arrays to be viewed as lists.&#xA;&#xA;&lt;p>The methods in this class all throw a &lt;tt>NullPointerException&lt;/tt> if&#xA;the specified array reference is null, except where noted.&#xA;&#xA;&lt;p>The documentation for the methods contained in this class includes&#xA;briefs description of the &lt;i>implementations&lt;/i>.  Such descriptions should&#xA;be regarded as &lt;i>implementation notes&lt;/i>, rather than parts of the&#xA;&lt;i>specification&lt;/i>.  Implementors should feel free to substitute other&#xA;algorithms, so long as the specification itself is adhered to.  (For&#xA;example, the algorithm used by &lt;tt>sort(Object[])&lt;/tt> does not have to be&#xA;a mergesort, but it does have to be &lt;i>stable&lt;/i>.)&#xA;&#xA;&lt;p>This class is a member of the&#xA;&lt;a href=&quot;{@docRoot}/../guide/collections/index.html&quot;>&#xA;Java Collections Framework&lt;/a>.&#xA;&#xA;@author  Josh Bloch&#xA;@author  Neal Gafter&#xA;@version 1.59, 04/01/04&#xA;@see     Comparable&#xA;@see     Comparator&#xA;@since   1.2&#xA;" annotatedElement="b9c3bc46-a8c8-4d73-a59d-29279eb04dc5"/>
            <nestedClassifier xmi:type="uml:Class" xmi:id="442d0563-63e9-4034-aede-183002ed912b" name="ArrayList" visibility="private" clientDependency="41df0c23-44ba-4464-9cf1-596a774de032 511a4743-6008-4ee8-87ba-7eba035be65c">
              <ownedComment xmi:id="e587883d-dcc9-47ac-9fa6-3e69eb21790d" body="@serial include&#xA;" annotatedElement="442d0563-63e9-4034-aede-183002ed912b"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="d707e5b9-309f-4cc2-862d-d740787ee287" name="" parameter="2a7b6b33-31ae-4e17-916a-124aaf989b6a">
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="2a7b6b33-31ae-4e17-916a-124aaf989b6a" parameteredElement="15959f0f-204b-42bf-a9cb-1bd16139769e">
