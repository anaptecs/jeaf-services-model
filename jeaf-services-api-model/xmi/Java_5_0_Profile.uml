              <parameterSubstitution xmi:id="e2321829-ad5b-4c4b-87ac-63ec6d716df5" formal="7f6977f5-d020-47ff-89b7-fdd5c9a21239" actual="6c8bd403-78f2-498f-8922-ed8d293ff70f"/>
            </templateBinding>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="adf08a21-5e35-466a-a4ec-50440fa1628b" name="ref">
            <packagedElement xmi:type="uml:Class" xmi:id="5c0d348d-6450-499a-a411-998da2e0128b" name="ReferenceQueue">
              <ownedComment xmi:id="2172172a-c912-4033-9f29-406fddd2dd9d" body="Reference queues, to which registered reference objects are appended by the&#xA;garbage collector after the appropriate reachability changes are detected.&#xA;&#xA;@version  1.23, 12/19/03&#xA;@author   Mark Reinhold&#xA;@since    1.2&#xA;" annotatedElement="5c0d348d-6450-499a-a411-998da2e0128b"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="6b7b5a07-856f-43c6-b595-cc7328575411" name="" parameter="0b274c69-27a1-42a0-a560-025a7d0a9e02">
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="0b274c69-27a1-42a0-a560-025a7d0a9e02" parameteredElement="88ed5bef-1122-4c7b-be98-889dd8a80fcc">
