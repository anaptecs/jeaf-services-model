            <packagedElement xmi:type="uml:Class" xmi:id="d1ef7ba1-1d91-4866-96bf-64991308e9c5" name="DelayQueue" clientDependency="89455af4-9022-4237-9dcf-da2a948b6e88">
              <ownedComment xmi:id="e59474f3-c8cc-4467-abf1-e5f4a48611b8" body="An unbounded {@linkplain BlockingQueue blocking queue} of&#xA;&lt;tt>Delayed&lt;/tt> elements, in which an element can only be taken&#xA;when its delay has expired.  The &lt;em>head&lt;/em> of the queue is that&#xA;&lt;tt>Delayed&lt;/tt> element whose delay expired furthest in the&#xA;past. If no delay has expired there is no head and &lt;tt>poll&lt;/tt>&#xA;will return &lt;tt>null&lt;/tt>. Expiration occurs when an element's&#xA;&lt;tt>getDelay(TimeUnit.NANOSECONDS)&lt;/tt> method returns a value less&#xA;than or equal to zero.  This queue does not permit &lt;tt>null&lt;/tt>&#xA;elements.&#xA;&#xA;&lt;p>This class and its iterator implement all of the&#xA;&lt;em>optional&lt;/em> methods of the {@link Collection} and {@link&#xA;Iterator} interfaces.&#xA;&#xA;&lt;p>This class is a member of the&#xA;&lt;a href=&quot;{@docRoot}/../guide/collections/index.html&quot;>&#xA;Java Collections Framework&lt;/a>.&#xA;&#xA;@since 1.5&#xA;@author Doug Lea&#xA;@param &lt;E> the type of elements held in this collection&#xA;" annotatedElement="d1ef7ba1-1d91-4866-96bf-64991308e9c5"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="16bbba79-a9b8-479c-a1de-9df02ff66d26" name="" parameter="63e8eefa-3e2b-4581-aa7f-4fa7af825d73">
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="63e8eefa-3e2b-4581-aa7f-4fa7af825d73" parameteredElement="38b5b122-c87d-472b-ab5f-6ca7d935cc8b">
                  <ownedParameteredElement xmi:type="uml:Class" xmi:id="38b5b122-c87d-472b-ab5f-6ca7d935cc8b" name="E" clientDependency="1fb34559-f2d6-482c-9a28-85ae0d6a2120" templateParameter="63e8eefa-3e2b-4581-aa7f-4fa7af825d73">
