                <ownedComment xmi:id="cb67661d-d328-4a79-b28f-8efc9752761a" body="Case independent unicode (including supplementary characters) value.&#xA;" annotatedElement="c294859c-8b53-41ce-84e7-94934d188070"/>
                <generalization xmi:id="bcffc503-8269-4fd2-a1dc-1300d55f7a31" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="0760a5ca-648f-4b8c-ad2b-3ae48cea8352" name="NotSingleU" visibility="package" isLeaf="true">
                <ownedComment xmi:id="5b45a863-7026-4f72-931c-79cc98c84866" body="Case independent unicode value.&#xA;" annotatedElement="0760a5ca-648f-4b8c-ad2b-3ae48cea8352"/>
                <generalization xmi:id="be1cff4f-e162-477a-8c98-0f8a806fe46a" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="4175806f-240e-45d4-b57b-dbb69537ac89" name="Category" visibility="package" isLeaf="true">
                <ownedComment xmi:id="2abb3df5-bc5c-4025-8000-8c8d68ec42b3" body="Node class that matches a Unicode category.&#xA;" annotatedElement="4175806f-240e-45d4-b57b-dbb69537ac89"/>
                <generalization xmi:id="d099056c-0213-4afa-b27f-ffd3ab474776" isSubstitutable="true" general="5696281d-9f3e-4135-8dea-88fea6adf625"/>
              </nestedClassifier>
