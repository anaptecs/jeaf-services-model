          <packagedElement xmi:type="uml:Interface" xmi:id="28f830e3-48a3-4eb3-9271-08e4eb82bbfb" name="Comparator&lt;Comparable&lt;Object>>">
            <templateBinding xmi:id="0e9a9eeb-d1b6-428c-8f03-1abcfe1ba733" signature="cd30edbb-8220-47dc-b526-cac60d4a1199">
