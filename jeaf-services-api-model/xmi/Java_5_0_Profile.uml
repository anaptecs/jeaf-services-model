                <ownedComment xmi:id="6f8a74a8-1c0d-4d43-b338-5ff19c27bdcc" body="An implementation of &lt;code>AttributeSet&lt;/code> that can multiplex&#xA;across a set of &lt;code>AttributeSet&lt;/code>s.&#xA;&#xA;@version 1.4 12/19/03&#xA;" annotatedElement="860e1b81-f504-45af-8ef3-63f397f27f4e"/>
                <interfaceRealization xmi:id="24485f17-1acf-464d-8d50-d353f030bd8f" name="" supplier="b2f778ba-2529-4067-a785-37ea17934002" client="860e1b81-f504-45af-8ef3-63f397f27f4e" contract="b2f778ba-2529-4067-a785-37ea17934002"/>
                <interfaceRealization xmi:id="98eb8c23-cb91-425e-b933-03ae6164a9e3" name="" supplier="f68aec46-50b5-48d7-b5b4-79aa18484c4c" client="860e1b81-f504-45af-8ef3-63f397f27f4e" contract="f68aec46-50b5-48d7-b5b4-79aa18484c4c"/>
