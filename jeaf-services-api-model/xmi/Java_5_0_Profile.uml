          <packagedElement xmi:type="uml:Class" xmi:id="932b0f96-cd91-4af5-891c-7c1ba18d7942" name="StackOverflowError">
            <ownedComment xmi:id="4890f1e7-1126-4166-9aff-a4b62c072fa3" body="Thrown when a stack overflow occurs because an application&#xA;recurses too deeply.&#xA;&#xA;@author unascribed&#xA;@version 1.21, 12/19/03&#xA;@since   JDK1.0&#xA;" annotatedElement="932b0f96-cd91-4af5-891c-7c1ba18d7942"/>
