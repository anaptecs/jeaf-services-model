            <packagedElement xmi:type="uml:Class" xmi:id="6b899779-1e83-4042-aab8-2490fd1edaa0" name="FutureTask&lt;V>">
              <templateBinding xmi:id="fd9ca4fe-c2b6-4926-bc85-6cfd9c0df372" signature="2a9b23a3-1162-48e7-9eb7-3f557410ec18">
                <parameterSubstitution xmi:id="47274671-0a36-4aa8-bdb9-dc7779020bff" formal="6f5701e9-3e77-4d33-b257-a125dbc32e74" actual="163b578c-d902-4fc0-8f51-1d33c9380478"/>
