              <nestedClassifier xmi:type="uml:Class" xmi:id="b7c64dd3-d340-48bf-93d0-bff0740bfca6" name="Handler" visibility="package" clientDependency="f5e87be7-04d5-469d-aa39-8acdd469f76c 9c7d4a08-3cb8-4066-b7d7-f9d157eaa057 b82469dd-8434-40f1-86d9-3aea7f511759 27170b2d-ca50-4488-8466-df1636101907">
                <interfaceRealization xmi:id="f5e87be7-04d5-469d-aa39-8acdd469f76c" name="" supplier="a5f9d9db-2cd9-4080-a286-ab40798c84e9" client="b7c64dd3-d340-48bf-93d0-bff0740bfca6" contract="a5f9d9db-2cd9-4080-a286-ab40798c84e9"/>
                <interfaceRealization xmi:id="27170b2d-ca50-4488-8466-df1636101907" name="" supplier="5b86cec3-6ac8-4cea-ac06-2f7df200ec4f" client="b7c64dd3-d340-48bf-93d0-bff0740bfca6" contract="5b86cec3-6ac8-4cea-ac06-2f7df200ec4f"/>
                <interfaceRealization xmi:id="9c7d4a08-3cb8-4066-b7d7-f9d157eaa057" name="" supplier="ed147bf5-dfa9-4fb9-9bf5-8ccadeda23ca" client="b7c64dd3-d340-48bf-93d0-bff0740bfca6" contract="ed147bf5-dfa9-4fb9-9bf5-8ccadeda23ca"/>
                <interfaceRealization xmi:id="b82469dd-8434-40f1-86d9-3aea7f511759" name="" supplier="46d5db63-61a6-4879-b712-03c93c99dde3" client="b7c64dd3-d340-48bf-93d0-bff0740bfca6" contract="46d5db63-61a6-4879-b712-03c93c99dde3"/>
