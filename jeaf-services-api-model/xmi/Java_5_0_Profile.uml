            <packagedElement xmi:type="uml:Class" xmi:id="ddc6cf0a-69a0-4b4d-9da0-fa9eb6db4201" name="ExpandVetoException">
              <ownedComment xmi:id="1beb012f-7eab-480c-b339-fc465d7b95f6" body="Exception used to stop and expand/collapse from happening.&#xA;See &lt;a&#xA;href=&quot;http://java.sun.com/docs/books/tutorial/uiswing/events/treewillexpandlistener.html&quot;>How to Write a Tree-Will-Expand Listener&lt;/a>&#xA;in &lt;em>The Java Tutorial&lt;/em>&#xA;for further information and examples.&#xA;&#xA;@version 1.10 12/19/03&#xA;@author Scott Violet&#xA;" annotatedElement="ddc6cf0a-69a0-4b4d-9da0-fa9eb6db4201"/>
