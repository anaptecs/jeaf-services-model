              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="8f430e47-d424-4289-aef2-4a583b0e9bd1" isSubstitutable="true" general="fffc2bc4-8dd9-41cb-bb31-c6a17f74704d"/>
            <interfaceRealization xmi:id="54a14e4b-b830-4db5-9c62-fb70c534c805" name="" supplier="798c1f41-63e5-47dc-9090-3495dac86a21" client="c8add247-3db2-45e3-ac1d-69f093f7157a" contract="798c1f41-63e5-47dc-9090-3495dac86a21"/>
            <interfaceRealization xmi:id="77f1892b-6a74-46a0-846e-88a1d224d5df" name="" supplier="f68aec46-50b5-48d7-b5b4-79aa18484c4c" client="c8add247-3db2-45e3-ac1d-69f093f7157a" contract="f68aec46-50b5-48d7-b5b4-79aa18484c4c"/>
            <nestedClassifier xmi:type="uml:Class" xmi:id="e5707754-18d3-4194-83ad-646b42ae2ec1" name="SerializationProxy" visibility="private" clientDependency="bf7e897d-7dc9-4b27-9f7b-99270ef9713a">
              <ownedComment xmi:id="786638ed-8307-4b63-aa40-c90f69769c32" body="This class is used to serialize all EnumSet instances, regardless of&#xA;implementation type.  It captures their &quot;logical contents&quot; and they&#xA;are reconstructed using public static factories.  This is necessary&#xA;to ensure that the existence of a particular implementation type is&#xA;an implementation detail.&#xA;&#xA;@serial include&#xA;" annotatedElement="e5707754-18d3-4194-83ad-646b42ae2ec1"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="f8aa3296-bad0-4c44-a96d-de0270b3854b" name="" parameter="caccd2d5-e412-4854-b913-11850c576566">
